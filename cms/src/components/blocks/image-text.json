{
  "collectionName": "components_blocks_image_texts",
  "info": {
    "displayName": "Image + Text",
    "icon": "columns",
    "description": "Image and text side by side, reversible"
  },
  "options": {},
  "attributes": {
    "heading": {
      "type": "string"
    },
    "eyebrow": {
      "type": "string"
    },
    "body": {
      "type": "richtext",
      "required": true
    },
    "image": {
      "type": "media",
      "allowedTypes": ["images"],
      "multiple": false
    },
    "image_position": {
      "type": "enumeration",
      "enum": ["left", "right"],
      "default": "left"
    },
    "image_fit": {
      "type": "enumeration",
      "enum": ["cover", "contain"],
      "default": "cover"
    },
    "aspect_ratio": {
      "type": "enumeration",
      "enum": ["4:3", "1:1"],
      "default": "4:3"
    },
    "section": {
      "type": "component",
      "component": "shared.section",
      "repeatable": false,
      "required": true
    },
    "container": {
      "type": "component",
      "component": "shared.container",
      "repeatable": false,
      "required": true
    }
  }
}
