{
  "collectionName": "components_blocks_image_texts",
  "info": {
    "displayName": "Image + Text",
    "icon": "columns",
    "description": "Image and text side by side, reversible"
  },
  "options": {},
  "attributes": {
    "visible": {
      "type": "boolean",
      "default": true
    },
    "heading": {
      "type": "string"
    },
    "eyebrow": {
      "type": "string"
    },
    "body": {
      "type": "richtext",
      "required": true
    },
    "image": {
      "type": "media",
      "allowedTypes": ["images"],
      "multiple": false
    },
    "cta_primary": {
      "type": "component",
      "component": "shared.link",
      "repeatable": false
    },
    "cta_secondary": {
      "type": "component",
      "component": "shared.link",
      "repeatable": false
    },
    "image_position": {
      "type": "enumeration",
      "enum": ["left", "right"],
      "default": "left"
    },
    "image_fit": {
      "type": "enumeration",
      "enum": ["cover", "contain"],
      "default": "cover"
    },
    "aspect_ratio": {
      "type": "enumeration",
      "enum": ["16:9", "3:2", "4:3", "1:1", "4:5"],
      "default": "4:3"
    },
    "section": {
      "type": "component",
      "component": "shared.section",
      "repeatable": false,
      "required": true
    },
    "container": {
      "type": "component",
      "component": "shared.container",
      "repeatable": false,
      "required": true
    }
  },
  "config": {
    "layouts": {
      "edit": [
        [{ "name": "visible", "size": 4 }],
        [
          { "name": "heading", "size": 6 },
          { "name": "eyebrow", "size": 6 }
        ],
        [{ "name": "body", "size": 12 }],
        [{ "name": "image", "size": 12 }],
        [
          { "name": "image_position", "size": 6 },
          { "name": "image_fit", "size": 6 }
        ],
        [{ "name": "aspect_ratio", "size": 6 }],
        [{ "name": "cta_primary", "size": 12 }],
        [{ "name": "cta_secondary", "size": 12 }],
        [{ "name": "section", "size": 12 }],
        [{ "name": "container", "size": 12 }]
      ]
    },
    "metadatas": {
      "visible": {
        "edit": {
          "description": "Se disattivato, questo blocco non viene mostrato nel sito."
        }
      },
      "cta_primary": {
        "edit": {
          "description": "CTA principale sotto il testo."
        }
      },
      "cta_secondary": {
        "edit": {
          "description": "CTA secondaria (opzionale), affiancata alla principale."
        }
      },
      "image_position": {
        "edit": {
          "description": "Lato dell'immagine rispetto al testo: left (sinistra) o right (destra). Alternalo tra blocchi consecutivi per l'effetto a zig-zag."
        }
      },
      "image_fit": {
        "edit": {
          "description": "Come l'immagine riempie il suo riquadro: cover (riempie tagliando i bordi) o contain (si vede intera, può lasciare spazi)."
        }
      },
      "aspect_ratio": {
        "edit": {
          "description": "Proporzione del riquadro immagine (ritaglio cover)."
        }
      }
    }
  }
}
