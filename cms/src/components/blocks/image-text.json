{
  "collectionName": "components_blocks_image_texts",
  "info": {
    "displayName": "Image + Text",
    "icon": "columns",
    "description": "Image and text side by side, reversible"
  },
  "options": {},
  "attributes": {
    "heading": {
      "type": "string"
    },
    "eyebrow": {
      "type": "string"
    },
    "body": {
      "type": "richtext",
      "required": true
    },
    "image": {
      "type": "media",
      "allowedTypes": ["images"],
      "multiple": false
    },
    "cta_text": {
      "type": "string"
    },
    "cta_url": {
      "type": "string"
    },
    "image_position": {
      "type": "enumeration",
      "enum": ["left", "right"],
      "default": "left"
    },
    "image_fit": {
      "type": "enumeration",
      "enum": ["cover", "contain"],
      "default": "cover"
    },
    "aspect_ratio": {
      "type": "enumeration",
      "enum": ["16:9", "3:2", "4:3", "1:1", "4:5"],
      "default": "4:3"
    },
    "section": {
      "type": "component",
      "component": "shared.section",
      "repeatable": false,
      "required": true
    },
    "container": {
      "type": "component",
      "component": "shared.container",
      "repeatable": false,
      "required": true
    }
  },
  "config": {
    "metadatas": {
      "cta_text": {
        "edit": {
          "description": "Testo del pulsante. La CTA compare solo se compili sia il testo sia il link."
        }
      },
      "cta_url": {
        "edit": {
          "description": "Destinazione del pulsante: un URL completo (https://...) o un percorso interno del sito (es. /contatti)."
        }
      },
      "image_position": {
        "edit": {
          "description": "Lato dell'immagine rispetto al testo: left (sinistra) o right (destra). Alternalo tra blocchi consecutivi per l'effetto a zig-zag."
        }
      },
      "image_fit": {
        "edit": {
          "description": "Come l'immagine riempie il suo riquadro: cover (riempie tagliando i bordi) o contain (si vede intera, può lasciare spazi)."
        }
      },
      "aspect_ratio": {
        "edit": {
          "description": "Proporzione del riquadro immagine (ritaglio cover)."
        }
      }
    }
  }
}
