{
  "collectionName": "components_blocks_rich_texts",
  "info": {
    "displayName": "Rich Text",
    "icon": "file-text",
    "description": "Markdown text block with optional alignment"
  },
  "options": {},
  "attributes": {
    "visible": {
      "type": "boolean",
      "default": true
    },
    "body": {
      "type": "richtext",
      "required": true
    },
    "cta_primary": {
      "type": "component",
      "component": "shared.link",
      "repeatable": false
    },
    "cta_secondary": {
      "type": "component",
      "component": "shared.link",
      "repeatable": false
    },
    "align": {
      "type": "enumeration",
      "enum": ["left", "center", "right"],
      "default": "left"
    },
    "reading_width": {
      "type": "enumeration",
      "enum": ["normal", "wide"],
      "default": "normal"
    },
    "section": {
      "type": "component",
      "component": "shared.section",
      "repeatable": false,
      "required": true
    }
  },
  "config": {
    "metadatas": {
      "visible": {
        "edit": {
          "description": "Se disattivato, questo blocco non viene mostrato nel sito."
        }
      },
      "cta_primary": {
        "edit": {
          "description": "CTA principale sotto il testo."
        }
      },
      "cta_secondary": {
        "edit": {
          "description": "CTA secondaria (opzionale), affiancata alla principale."
        }
      },
      "align": {
        "edit": {
          "description": "Allineamento del testo: left (sinistra), center (centrato), right (destra)."
        }
      },
      "reading_width": {
        "edit": {
          "description": "Larghezza della colonna: normal (misura di lettura standard) o wide (più larga, circa 860px). Tienila su normal per la massima leggibilità."
        }
      }
    }
  }
}
