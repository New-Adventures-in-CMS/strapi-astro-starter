{
  "collectionName": "components_blocks_forms",
  "info": {
    "displayName": "Form",
    "icon": "file-text",
    "description": "Embeds a dynamic form from the Form collection"
  },
  "options": {},
  "attributes": {
    "eyebrow": {
      "type": "string"
    },
    "heading": {
      "type": "string"
    },
    "lead": {
      "type": "text"
    },
    "reading_width": {
      "type": "enumeration",
      "enum": ["normal", "wide"],
      "default": "normal"
    },
    "form": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::form.form"
    },
    "section": {
      "type": "component",
      "component": "shared.section",
      "repeatable": false,
      "required": true
    }
  }
}
