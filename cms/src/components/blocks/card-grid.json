{
  "collectionName": "components_blocks_card_grids",
  "info": {
    "displayName": "Card Grid",
    "icon": "grid",
    "description": "Grid of feature/info cards"
  },
  "options": {},
  "attributes": {
    "eyebrow": {
      "type": "string"
    },
    "heading": {
      "type": "string"
    },
    "lead": {
      "type": "text"
    },
    "tone": {
      "type": "enumeration",
      "default": "light",
      "enum": [
        "light",
        "dark"
      ]
    },
    "cards": {
      "type": "component",
      "component": "shared.card",
      "repeatable": true
    },
    "width": {
      "type": "enumeration",
      "enum": ["full", "contained"],
      "default": "contained"
    },
    "spacing": {
      "type": "enumeration",
      "enum": ["none", "sm", "md", "lg", "xl"],
      "default": "xl"
    }
  }
}
