{
  "collectionName": "components_blocks_carousels",
  "info": {
    "displayName": "Carousel",
    "icon": "columns",
    "description": "Card carousel with peek rail"
  },
  "options": {},
  "attributes": {
    "shown": {
      "type": "boolean",
      "default": true
    },
    "autoplay": {
      "type": "boolean",
      "default": false
    },
    "loop": {
      "type": "boolean",
      "default": false
    },
    "heading": {
      "type": "string"
    },
    "eyebrow": {
      "type": "string"
    },
    "lead": {
      "type": "text"
    },
    "aspect_ratio": {
      "type": "enumeration",
      "enum": ["16:9", "3:2", "4:3", "1:1", "4:5"],
      "default": "16:9"
    },
    "cta_style": {
      "type": "enumeration",
      "enum": ["button", "full_card"],
      "default": "button"
    },
    "cards": {
      "type": "component",
      "component": "shared.card",
      "repeatable": true
    },
    "section": {
      "type": "component",
      "component": "shared.section",
      "repeatable": false,
      "required": true
    },
    "container": {
      "type": "component",
      "component": "shared.container",
      "repeatable": false,
      "required": true
    },
    "cta_primary": {
      "type": "component",
      "component": "shared.link",
      "repeatable": false
    },
    "cta_secondary": {
      "type": "component",
      "component": "shared.link",
      "repeatable": false
    }
  },
  "config": {
    "layouts": {
      "edit": [
        [{ "name": "shown", "size": 4 }],
        [
          { "name": "heading", "size": 6 },
          { "name": "eyebrow", "size": 6 }
        ],
        [{ "name": "lead", "size": 12 }],
        [{ "name": "cards", "size": 12 }],
        [
          { "name": "aspect_ratio", "size": 6 },
          { "name": "cta_style", "size": 6 }
        ],
        [
          { "name": "autoplay", "size": 6 },
          { "name": "loop", "size": 6 }
        ],
        [{ "name": "cta_primary", "size": 12 }],
        [{ "name": "cta_secondary", "size": 12 }],
        [{ "name": "section", "size": 12 }],
        [{ "name": "container", "size": 12 }]
      ]
    },
    "metadatas": {
      "shown": {
        "edit": {
          "description": "Se disattivato, questo blocco non viene mostrato nel sito."
        }
      },
      "autoplay": {
        "edit": {
          "description": "Se attivo, il carosello scorre da solo. Valuta l'accessibilità prima di attivarlo."
        }
      },
      "loop": {
        "edit": {
          "description": "Se attivo, dopo l'ultima slide il carosello riparte dalla prima (scorrimento infinito)."
        }
      },
      "aspect_ratio": {
        "edit": {
          "description": "Proporzione delle immagini del blocco (ritaglio cover, altezza uniforme)."
        }
      },
      "cta_style": {
        "edit": {
          "description": "Come appaiono le CTA delle card: button visibile, oppure intera card cliccabile con zoom dell'immagine in hover."
        }
      }
    }
  }
}
