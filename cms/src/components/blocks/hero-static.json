{
  "collectionName": "components_blocks_hero_statics",
  "info": {
    "displayName": "Hero Static",
    "icon": "picture",
    "description": "Full-width static hero banner with heading, text, optional CTA and image effects"
  },
  "options": {},
  "attributes": {
    "shown": {
      "type": "boolean",
      "default": true
    },
    "heading": {
      "type": "string",
      "required": true
    },
    "eyebrow": {
      "type": "string"
    },
    "subheading": {
      "type": "text"
    },
    "cta_primary": {
      "type": "component",
      "component": "shared.link",
      "repeatable": false
    },
    "cta_secondary": {
      "type": "component",
      "component": "shared.link",
      "repeatable": false
    },
    "media_type": {
      "type": "enumeration",
      "enum": ["image", "video"],
      "default": "image"
    },
    "image": {
      "type": "media",
      "allowedTypes": ["images"],
      "multiple": false,
      "conditions": {
        "visible": {
          "==": [{ "var": "media_type" }, "image"]
        }
      }
    },
    "poster": {
      "type": "media",
      "allowedTypes": ["images"],
      "multiple": false,
      "conditions": {
        "visible": {
          "==": [{ "var": "media_type" }, "video"]
        }
      }
    },
    "video": {
      "type": "media",
      "allowedTypes": ["videos"],
      "multiple": false,
      "conditions": {
        "visible": {
          "==": [{ "var": "media_type" }, "video"]
        }
      }
    },
    "immersive": {
      "type": "boolean",
      "default": false
    },
    "align": {
      "type": "enumeration",
      "enum": [
        "center",
        "top-left",
        "top-center",
        "top-right",
        "middle-left",
        "middle-right",
        "bottom-left",
        "bottom-center",
        "bottom-right"
      ],
      "default": "center"
    },
    "effect": {
      "type": "enumeration",
      "enum": ["none", "tilt", "ken-burns"],
      "default": "none",
      "conditions": {
        "visible": {
          "==": [{ "var": "media_type" }, "image"]
        }
      }
    },
    "aspect_ratio": {
      "type": "enumeration",
      "enum": ["16:9", "21:9", "3:1"],
      "conditions": {
        "shown": {
          "==": [{ "var": "immersive" }, false]
        }
      }
    },
    "anchor_id": {
      "type": "string"
    }
  },
  "config": {
    "layouts": {
      "edit": [
        [{ "name": "shown", "size": 4 }],
        [
          { "name": "heading", "size": 6 },
          { "name": "eyebrow", "size": 6 }
        ],
        [{ "name": "subheading", "size": 12 }],
        [
          { "name": "image", "size": 8 },
          { "name": "media_type", "size": 4 }
        ],
        [{ "name": "video", "size": 12 }],
        [{ "name": "poster", "size": 12 }],
        [{ "name": "aspect_ratio", "size": 6 }],
        [{ "name": "cta_primary", "size": 12 }],
        [{ "name": "cta_secondary", "size": 12 }],
        [
          { "name": "immersive", "size": 4 },
          { "name": "align", "size": 4 },
          { "name": "effect", "size": 4 }
        ],
        [{ "name": "anchor_id", "size": 6 }]
      ]
    },
    "metadatas": {
      "shown": {
        "edit": {
          "description": "Se disattivato, questo blocco non viene mostrato nel sito."
        }
      },
      "cta_primary": {
        "edit": {
          "description": "CTA principale. Compare solo se compili almeno il testo."
        }
      },
      "cta_secondary": {
        "edit": {
          "description": "CTA secondaria (opzionale), affiancata alla principale."
        }
      },
      "media_type": {
        "edit": {
          "description": "Scegli se l'hero mostra un'immagine o un video mp4."
        }
      },
      "image": {
        "edit": {
          "description": "Immagine dell'hero."
        }
      },
      "poster": {
        "edit": {
          "description": "Immagine di anteprima del video: viene mostrata prima che il video parta, come fallback, e quando l'utente ha le animazioni ridotte (reduced-motion)."
        }
      },
      "video": {
        "edit": {
          "description": "File video mp4. Il campo poster fornisce l'anteprima e il first paint."
        }
      },
      "immersive": {
        "edit": {
          "description": "Se attivo, l'hero occupa tutta l'altezza dello schermo e l'header ci va sopra in trasparenza."
        }
      },
      "align": {
        "edit": {
          "description": "Posizione del contenuto sull'immagine: center (default), oppure uno dei nove punti della griglia."
        }
      },
      "effect": {
        "edit": {
          "description": "Effetto sull'immagine statica: none (nessuno), tilt (inclinazione 3D al mouse), ken-burns (zoom lento continuo)."
        }
      },
      "aspect_ratio": {
        "edit": {
          "description": "Rapporto d'aspetto della fascia (banner). Visibile solo se immersive è spento. Da tablet in su impone il rapporto; su mobile ha un pavimento di altezza minima."
        }
      },
      "anchor_id": {
        "edit": {
          "description": "ID àncora dell'hero (es. 'hero-home'). Dev'essere univoco nella pagina: id duplicati rompono la navigazione in silenzio."
        }
      }
    }
  }
}
