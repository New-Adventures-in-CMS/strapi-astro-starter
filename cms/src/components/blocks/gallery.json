{
  "collectionName": "components_blocks_galleries",
  "info": {
    "displayName": "Gallery",
    "icon": "landscape",
    "description": "Image gallery with lightbox"
  },
  "options": {},
  "attributes": {
    "eyebrow": {
      "type": "string"
    },
    "heading": {
      "type": "string"
    },
    "lead": {
      "type": "text"
    },
    "aspect_ratio": {
      "type": "enumeration",
      "enum": ["16:9", "3:2", "4:3", "1:1", "4:5"]
    },
    "display": {
      "type": "enumeration",
      "enum": ["grid", "carousel"],
      "default": "grid"
    },
    "loop": {
      "type": "boolean",
      "default": false,
      "conditions": {
        "visible": {
          "==": [{ "var": "display" }, "carousel"]
        }
      }
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "section": {
      "type": "component",
      "component": "shared.section",
      "repeatable": false,
      "required": true
    },
    "container": {
      "type": "component",
      "component": "shared.container",
      "repeatable": false,
      "required": true
    },
    "cta_primary": {
      "type": "component",
      "component": "shared.link",
      "repeatable": false
    },
    "cta_secondary": {
      "type": "component",
      "component": "shared.link",
      "repeatable": false
    }
  },
  "config": {
    "layouts": {
      "edit": [
        [
          { "name": "eyebrow", "size": 6 },
          { "name": "heading", "size": 6 }
        ],
        [{ "name": "lead", "size": 12 }],
        [{ "name": "images", "size": 12 }],
        [{ "name": "aspect_ratio", "size": 6 }],
        [
          { "name": "display", "size": 6 },
          { "name": "loop", "size": 6 }
        ],
        [{ "name": "cta_primary", "size": 12 }],
        [{ "name": "cta_secondary", "size": 12 }],
        [{ "name": "section", "size": 12 }],
        [{ "name": "container", "size": 12 }]
      ]
    },
    "metadatas": {
      "display": {
        "edit": {
          "description": "Come mostrare le immagini: griglia di thumbnail o carosello scorrevole con peek."
        }
      },
      "loop": {
        "edit": {
          "description": "Se attivo, il carosello riparte dalla prima immagine dopo l'ultima. Ha effetto solo in vista carosello."
        }
      },
      "aspect_ratio": {
        "edit": {
          "description": "Proporzione delle immagini del blocco (ritaglio cover, altezza uniforme). Se non specificato: griglia usa 3:2, carosello usa 16:9."
        }
      }
    }
  }
}
