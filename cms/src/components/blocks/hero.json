{
  "collectionName": "components_blocks_heroes",
  "info": {
    "displayName": "Hero",
    "icon": "picture",
    "description": "Full-width hero banner with heading, text, and optional CTA"
  },
  "options": {},
  "attributes": {
    "heading": {
      "type": "string",
      "required": true
    },
    "eyebrow": {
      "type": "string"
    },
    "subheading": {
      "type": "text"
    },
    "cta_text": {
      "type": "string"
    },
    "cta_url": {
      "type": "string"
    },
    "image": {
      "type": "media",
      "allowedTypes": ["images"],
      "multiple": false
    },
    "immersive": {
      "type": "boolean",
      "default": false
    },
    "slides": {
      "type": "component",
      "repeatable": true,
      "component": "hero.slide"
    },
    "align": {
      "type": "enumeration",
      "enum": [
        "center",
        "top-left",
        "top-center",
        "top-right",
        "middle-left",
        "middle-right",
        "bottom-left",
        "bottom-center",
        "bottom-right"
      ],
      "default": "center"
    },
    "heroStyle": {
      "type": "enumeration",
      "enum": [
        "fade",
        "slide",
        "drift",
        "focus",
        "dim",
        "parallax",
        "tilt",
        "ken-burns"
      ],
      "default": "fade"
    }
  }
}
