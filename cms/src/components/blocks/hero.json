{
  "collectionName": "components_blocks_heroes",
  "info": {
    "displayName": "Hero",
    "icon": "picture",
    "description": "Full-width hero banner with heading, text, and optional CTA"
  },
  "options": {},
  "attributes": {
    "heading": {
      "type": "string",
      "required": true
    },
    "eyebrow": {
      "type": "string"
    },
    "subheading": {
      "type": "text"
    },
    "cta_primary": {
      "type": "component",
      "component": "shared.link",
      "repeatable": false
    },
    "cta_secondary": {
      "type": "component",
      "component": "shared.link",
      "repeatable": false
    },
    "image": {
      "type": "media",
      "allowedTypes": ["images"],
      "multiple": false
    },
    "immersive": {
      "type": "boolean",
      "default": false
    },
    "slides": {
      "type": "component",
      "repeatable": true,
      "component": "hero.slide"
    },
    "align": {
      "type": "enumeration",
      "enum": [
        "center",
        "top-left",
        "top-center",
        "top-right",
        "middle-left",
        "middle-right",
        "bottom-left",
        "bottom-center",
        "bottom-right"
      ],
      "default": "center"
    },
    "heroStyle": {
      "type": "enumeration",
      "enum": ["fade", "slide", "drift", "focus", "dim", "parallax", "tilt", "ken-burns"],
      "default": "fade"
    }
  },
  "config": {
    "metadatas": {
      "cta_primary": {
        "edit": {
          "description": "CTA principale. Compare solo se compili almeno il testo."
        }
      },
      "cta_secondary": {
        "edit": {
          "description": "CTA secondaria (opzionale), affiancata alla principale."
        }
      },
      "image": {
        "edit": {
          "description": "Immagine dell'hero. Se sono presenti delle slide, questa vale come sfondo di riserva."
        }
      },
      "immersive": {
        "edit": {
          "description": "Se attivo, l'hero occupa tutta l'altezza dello schermo e l'header ci va sopra in trasparenza. Se spento, hero di altezza normale."
        }
      },
      "slides": {
        "edit": {
          "description": "Più slide rendono l'hero uno slider. Lascia vuoto per un hero singolo."
        }
      },
      "align": {
        "edit": {
          "description": "Posizione del contenuto sull'immagine: center (default), oppure uno dei nove punti della griglia (es. top-left, bottom-center)."
        }
      },
      "heroStyle": {
        "edit": {
          "description": "Effetto di transizione tra le slide: fade (dissolvenza), slide (scorrimento), drift (parallasse), focus (zoom-in), dim (oscuramento), parallax (profondità), tilt (inclinazione 3D), ken-burns (zoom lento continuo)."
        }
      }
    }
  }
}
