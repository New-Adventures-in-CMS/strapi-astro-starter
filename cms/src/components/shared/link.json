{
  "collectionName": "components_shared_links",
  "info": {
    "displayName": "Link",
    "icon": "link",
    "description": "Configurable button link (internal page or external URL) with target control"
  },
  "options": {},
  "attributes": {
    "label": {
      "type": "string",
      "required": true
    },
    "linkMode": {
      "type": "enumeration",
      "enum": ["internal", "anchor", "external"],
      "default": "internal",
      "required": true
    },
    "page": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::page.page",
      "conditions": {
        "visible": {
          "==": [{ "var": "linkMode" }, "internal"]
        }
      }
    },
    "externalUrl": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [{ "var": "linkMode" }, "external"]
        }
      }
    },
    "anchor": {
      "type": "string",
      "conditions": {
        "visible": {
          "!=": [{ "var": "linkMode" }, "external"]
        }
      }
    },
    "target": {
      "type": "enumeration",
      "enum": ["auto", "blank", "self"],
      "default": "auto"
    }
  },
  "config": {
    "layouts": {
      "edit": [
        [
          { "name": "linkMode", "size": 6 },
          { "name": "label", "size": 6 }
        ],
        [{ "name": "page", "size": 12 }],
        [{ "name": "externalUrl", "size": 12 }],
        [{ "name": "anchor", "size": 6 }, { "name": "target", "size": 6 }]
      ]
    },
    "metadatas": {
      "label": {
        "edit": {
          "description": "Testo del pulsante."
        }
      },
      "linkMode": {
        "edit": {
          "description": "Tipo di link: internal (pagina del sito), anchor (àncora nella pagina corrente), external (URL esterno)."
        }
      },
      "page": {
        "edit": {
          "description": "Pagina interna a cui punta il link (solo se linkMode = internal)."
        }
      },
      "externalUrl": {
        "edit": {
          "description": "URL esterno completo (solo se linkMode = external)."
        }
      },
      "anchor": {
        "edit": {
          "description": "ID della sezione di arrivo (es. 'servizi'). Dev'essere univoco nella pagina. In modo Anchor punta a questa pagina (#id); in modo Internal aggiunge il punto di arrivo sulla pagina collegata (/slug#id)."
        }
      },
      "target": {
        "edit": {
          "description": "Come si apre il link: auto (interno = stessa finestra, esterno = nuova), blank (sempre nuova finestra), self (sempre stessa finestra)."
        }
      }
    }
  }
}
