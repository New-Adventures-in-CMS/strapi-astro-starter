{
  "kind": "collectionType",
  "collectionName": "forms",
  "info": {
    "singularName": "form",
    "pluralName": "forms",
    "displayName": "Form",
    "description": "Form dinamici configurabili dall'admin"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "nome": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "nome",
      "required": true
    },
    "emailDestinatario": {
      "type": "string"
    },
    "messaggioSuccesso": {
      "type": "string",
      "default": "Grazie! Il tuo messaggio è stato inviato."
    },
    "submissions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::form-submission.form-submission",
      "mappedBy": "form"
    },
    "campi": {
      "type": "dynamiczone",
      "components": [
        "form.campo-testo",
        "form.campo-email",
        "form.campo-textarea",
        "form.campo-select",
        "form.campo-checkbox"
      ],
      "required": true,
      "min": 1
    }
  },
  "config": {
    "metadatas": {
      "emailDestinatario": {
        "edit": {
          "description": "Indirizzo email a cui arrivano le compilazioni di questo modulo."
        }
      },
      "messaggioSuccesso": {
        "edit": {
          "description": "Messaggio mostrato all'utente dopo l'invio riuscito."
        }
      }
    }
  }
}
