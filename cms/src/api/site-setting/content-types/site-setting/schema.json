{
  "kind": "singleType",
  "collectionName": "site_settings",
  "info": {
    "singularName": "site-setting",
    "pluralName": "site-settings",
    "displayName": "Site settings",
    "description": "Impostazioni globali del sito (singleton). Layout di header, submenu e footer."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "submenuLayout": {
      "type": "enumeration",
      "enum": ["full-bleed", "dropdown"],
      "default": "full-bleed",
      "required": true
    },
    "headerWidth": {
      "type": "enumeration",
      "enum": ["full", "contained"],
      "default": "full",
      "required": true
    },
    "footerWidth": {
      "type": "enumeration",
      "enum": ["full", "contained"],
      "default": "full",
      "required": true
    },
    "footerTone": {
      "type": "enumeration",
      "enum": ["muted", "dark"],
      "default": "dark",
      "required": true
    },
    "stickyShell": {
      "type": "boolean",
      "default": true,
      "required": true
    },
    "imageMaskReveal": {
      "type": "boolean",
      "default": true,
      "required": true
    },
    "companyName": {
      "type": "string"
    },
    "vatNumber": {
      "type": "string"
    },
    "address": {
      "type": "text"
    },
    "socialLinks": {
      "type": "component",
      "repeatable": true,
      "component": "shared.social-link"
    }
  },
  "config": {
    "layouts": {
      "edit": [
        [
          { "name": "submenuLayout", "size": 6 },
          { "name": "headerWidth", "size": 6 }
        ],
        [
          { "name": "footerWidth", "size": 6 },
          { "name": "footerTone", "size": 6 }
        ],
        [
          { "name": "stickyShell", "size": 6 },
          { "name": "imageMaskReveal", "size": 6 }
        ],
        [
          { "name": "companyName", "size": 6 },
          { "name": "vatNumber", "size": 6 }
        ],
        [{ "name": "address", "size": 12 }],
        [{ "name": "socialLinks", "size": 12 }]
      ]
    },
    "metadatas": {
      "submenuLayout": {
        "edit": {
          "description": "Layout dei sottomenu dell'header: full-bleed (banda a tutta larghezza) o dropdown (menu a tendina compatto)."
        }
      },
      "headerWidth": {
        "edit": {
          "description": "Larghezza dell'header: full (a tutta pagina, con margini editoriali) o contained (incolonnato, allineato ai contenuti)."
        }
      },
      "footerWidth": {
        "edit": {
          "description": "Larghezza del footer: full (a tutta pagina, con margini editoriali) o contained (incolonnato, allineato ai contenuti)."
        }
      },
      "footerTone": {
        "edit": {
          "description": "Tono di sfondo del footer: muted (tenue, con testo scuro) o dark (scuro, con testo chiaro)."
        }
      },
      "stickyShell": {
        "edit": {
          "description": "Se attivo, header e hero restano agganciati in cima durante lo scroll."
        }
      },
      "imageMaskReveal": {
        "edit": {
          "description": "Se attivo, le immagini si rivelano con un effetto maschera quando entrano nello schermo."
        }
      }
    }
  }
}
