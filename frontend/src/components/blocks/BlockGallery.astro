---
import type {
  SharedSection,
  SharedContainer,
  StrapiMedia,
  GalleryDisplay,
  AspectRatio,
  SharedLink,
} from "@/types";
import { Section, Container } from "@/components/layout";
import SectionHeader from "@/components/SectionHeader.astro";
import CtaLink from "@/components/CtaLink.astro";
import StrapiImage from "@/components/StrapiImage.astro";
import DialogPrimitive from "@starwind-ui/astro/dialog";
import {
  dialogBackdrop,
  dialogContent,
  dialogCloseButton,
} from "@/components/starwind/dialog/variants";
import { gallery as galleryTv, carousel as cv, aspectRatioClass } from "./variants";

interface Props {
  heading?: string | null;
  eyebrow?: string | null;
  lead?: string | null;
  aspect_ratio?: AspectRatio;
  display?: GalleryDisplay | null;
  loop?: boolean | null;
  images: StrapiMedia[];
  cta_primary?: SharedLink | null;
  cta_secondary?: SharedLink | null;
  section?: SharedSection;
  container?: SharedContainer;
}

const {
  heading,
  eyebrow,
  lead,
  aspect_ratio,
  display,
  loop,
  images,
  cta_primary,
  cta_secondary,
  section: sec,
  container,
} = Astro.props;
const arClass = aspectRatioClass[aspect_ratio ?? (display === "carousel" ? "16:9" : "3:2")];
const tone = sec?.tone ?? "default";
const spacing = sec?.spacing ?? "xl";
const width = container?.width ?? "contained";
const onDark = tone === "dark";
const isCarousel = display === "carousel";
const showCta = cta_primary || cta_secondary;
const ctaAlignClass = isCarousel ? "" : "justify-center";
const gv = galleryTv({ width });
const thumbSizes = isCarousel
  ? "(min-width: 1024px) 64vw, (min-width: 640px) 46vw, 82vw"
  : "(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw";
---

<Section tone={tone} spacing={spacing}>
  {isCarousel && (
    <Container width={width}>
      <SectionHeader eyebrow={eyebrow} heading={heading} lead={lead} align="left" onDark={onDark} />
    </Container>
  )}

  <Container width={width}>
    {!isCarousel && (
      <SectionHeader
        eyebrow={eyebrow}
        heading={heading}
        lead={lead}
        align="center"
        onDark={onDark}
      />
    )}

    {images.length > 0 && (
      <div data-lightbox>
        {!isCarousel && (
          <div class={gv.grid()} data-reveal="stagger" data-mask-grid>
            {images.map((img, i) => (
              <button type="button" data-lightbox-thumb data-index={i} class={gv.thumb()}>
                <div data-mask-reveal class="overflow-hidden" style={`--mask-delay:${i * 100}ms`}>
                  <StrapiImage
                    image={img}
                    sizes={thumbSizes}
                    class={`${arClass} w-full object-cover`}
                    loadingIndicator="blur"
                  />
                </div>
                {img.caption && (
                  <div
                    class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-foreground/70 to-transparent px-3 pb-2 pt-6 opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100 motion-reduce:transition-none"
                    data-gallery-caption
                  >
                    <p class="text-xs text-background">{img.caption}</p>
                  </div>
                )}
              </button>
            ))}
          </div>
        )}

        {isCarousel && (
          <div
            data-gallery-carousel
            data-loop={loop || undefined}
            tabindex="0"
            class="relative"
            data-reveal
          >
            <div class={cv.viewport()} data-carousel-viewport>
              <div class={cv.track()}>
                {images.map((img, i) => (
                  <div class={gv.carouselSlide()}>
                    <button
                      type="button"
                      data-lightbox-thumb
                      data-index={i}
                      class:list={[gv.thumb(), "block w-full h-full"]}
                    >
                      <StrapiImage
                        image={img}
                        sizes={thumbSizes}
                        class={`${arClass} w-full object-cover`}
                        loadingIndicator="blur"
                      />
                      {img.caption && (
                        <div
                          class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-foreground/70 to-transparent px-3 pb-2 pt-6 opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100 motion-reduce:transition-none"
                          data-gallery-caption
                        >
                          <p class="text-xs text-background">{img.caption}</p>
                        </div>
                      )}
                    </button>
                  </div>
                ))}
              </div>
            </div>
            <div class={cv.controls()}>
              <button class={cv.navBtn()} data-carousel-prev type="button" aria-label="Precedente">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 19l-7-7 7-7"
                  />
                </svg>
              </button>
              <button class={cv.navBtn()} data-carousel-next type="button" aria-label="Successivo">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 5l7 7-7 7"
                  />
                </svg>
              </button>
              <div class={cv.scrollbar()} data-carousel-bar aria-hidden="true">
                <div class={cv.scrollbarThumb()} data-carousel-bar-thumb></div>
              </div>
            </div>
          </div>
        )}

        <DialogPrimitive.Root
          closeOnEscape={true}
          closeOnOutsideInteract={false}
          modal={true}
          data-slot="dialog"
        >
          <DialogPrimitive.Backdrop
            class={dialogBackdrop()}
            data-state="closed"
            hidden
            data-slot="dialog-backdrop"
          />

          <DialogPrimitive.Popup
            class={dialogContent({ surface: "lightbox" })}
            data-state="closed"
            aria-label="Galleria immagini"
            data-slot="dialog-content"
          >
            <div
              data-lightbox-carousel
              tabindex="0"
              class="flex h-full w-full flex-col items-center justify-center outline-none"
            >
              <div class="relative flex w-full flex-1 items-center" data-carousel-viewport>
                <div class="flex h-full w-full">
                  {images.map((img) => (
                    <div class="min-w-0 shrink-0 grow-0 basis-full flex items-center justify-center">
                      <figure class="flex h-full w-full flex-col items-center justify-center">
                        <StrapiImage
                          image={img}
                          sizes="100vw"
                          loading="lazy"
                          class="mx-auto max-h-[calc(100vh-8rem)] w-full object-contain"
                          loadingIndicator="spinner"
                          wrapperClass="flex items-center justify-center w-full h-full"
                        />
                        {img.caption && (
                          <figcaption class="mt-3 text-center text-sm text-background/70">
                            {img.caption}
                          </figcaption>
                        )}
                      </figure>
                    </div>
                  ))}
                </div>
              </div>

              <button
                type="button"
                data-carousel-prev
                class="absolute left-4 top-1/2 -translate-y-1/2 rounded-full bg-background/20 p-3 text-background shadow transition hover:bg-background/40 disabled:opacity-30"
                aria-label="Precedente"
              >
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 19l-7-7 7-7"
                  />
                </svg>
              </button>
              <button
                type="button"
                data-carousel-next
                class="absolute right-14 top-1/2 -translate-y-1/2 rounded-full bg-background/20 p-3 text-background shadow transition hover:bg-background/40 disabled:opacity-30"
                aria-label="Successivo"
              >
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 5l7 7-7 7"
                  />
                </svg>
              </button>
            </div>

            <button
              type="button"
              data-sw-dialog-close
              class={dialogCloseButton({ surface: "lightbox" })}
              aria-label="Chiudi"
              data-slot="dialog-close"
            >
              <svg
                class="size-6 transition-opacity"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M6 18L18 6M6 6l12 12"
                />
              </svg>
              <span class="sr-only">Chiudi</span>
            </button>
          </DialogPrimitive.Popup>
        </DialogPrimitive.Root>
      </div>
    )}
    {showCta && (
      <div
        class:list={["mt-[var(--content-rhythm-xl)] flex flex-wrap gap-3", ctaAlignClass]}
        data-section-cta
        data-reveal
      >
        {cta_primary && <CtaLink link={cta_primary} variant="primary" />}
        {cta_secondary && <CtaLink link={cta_secondary} variant="secondary" />}
      </div>
    )}
  </Container>
</Section>

<script>
  import { createLightbox } from "@skeleton/lightbox.js";
  import { createCarousel } from "@skeleton/carousel.js";

  document.querySelectorAll<HTMLElement>("[data-lightbox]").forEach((root) => {
    createLightbox(root);
  });

  document.querySelectorAll<HTMLElement>("[data-gallery-carousel]").forEach((root) => {
    const prevBtn = root.querySelector<HTMLElement>("[data-carousel-prev]") ?? undefined;
    const nextBtn = root.querySelector<HTMLElement>("[data-carousel-next]") ?? undefined;
    const loop = root.hasAttribute("data-loop");
    const api = createCarousel(root, {
      loop,
      align: "start",
      prevBtn,
      nextBtn,
      labels: {
        prev: "Precedente",
        next: "Successivo",
        slide: (i) => `Immagine ${i + 1}`,
      },
    });

    const thumb = root.querySelector<HTMLElement>("[data-carousel-bar-thumb]");
    if (thumb) {
      let n = Math.max(1, api.snapCount());
      function sizeThumb() {
        n = Math.max(1, api.snapCount());
        thumb!.style.width = `${100 / n}%`;
      }
      function moveThumb() {
        thumb!.style.transform = `translateX(${api.selectedIndex() * 100}%)`;
      }
      sizeThumb();
      moveThumb();
      api.on("select", moveThumb);
      api.on("reInit", () => {
        sizeThumb();
        moveThumb();
      });
    }
  });
</script>
