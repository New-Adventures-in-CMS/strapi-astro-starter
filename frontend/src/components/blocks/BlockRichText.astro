---
import type { SharedSection } from "@/types";
import { Prose } from "@/components/starwind/prose";
import { Section, Container } from "@/components/layout";
import { renderMarkdown } from "@/lib/markdown";

interface Props {
  body: string;
  align?: "left" | "center" | "right" | null;
  section?: SharedSection;
}

const { body, align, section: sec } = Astro.props;
const tone = sec?.tone ?? "default";
const spacing = sec?.spacing ?? "xl";
const html = renderMarkdown(body);
const alignClass =
  align === "center"
    ? "text-center [&_h1]:text-center [&_h2]:text-center [&_h3]:text-center [&_p]:text-center [&_li]:text-center"
    : align === "right"
      ? "text-right [&_h1]:text-right [&_h2]:text-right [&_h3]:text-right [&_p]:text-right [&_li]:text-right"
      : undefined;
const compact = (spacing ?? "xl") === "none";
---

<Section tone={tone} spacing={spacing} data-richtext-compact={compact ? "" : undefined}>
  <Container width="prose" class={alignClass} data-reveal>
    <Prose class={alignClass}>
      <div set:html={html} />
    </Prose>
  </Container>
</Section>
