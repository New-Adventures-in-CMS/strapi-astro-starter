---
import type { ReadingWidth, SharedSection, SharedLink } from "@/types";
import { Prose } from "@/components/starwind/prose";
import { Section, Container } from "@/components/layout";
import CtaLink from "@/components/CtaLink.astro";
import { renderMarkdown } from "@/lib/markdown";
import { slugifyAnchor } from "@/lib/links";

interface Props {
  body: string;
  cta_primary?: SharedLink | null;
  cta_secondary?: SharedLink | null;
  align?: "left" | "center" | "right" | null;
  reading_width?: ReadingWidth | null;
  section?: SharedSection;
}

const { body, cta_primary, cta_secondary, align, reading_width, section: sec } = Astro.props;
const isWide = reading_width === "wide";
const containerWidth = isWide ? "reading-wide" : "prose";
const showCta = cta_primary || cta_secondary;
const tone = sec?.tone ?? "default";
const spacing = sec?.spacing ?? "xl";
const html = renderMarkdown(body);
const alignClass =
  align === "center"
    ? "text-center [&_h1]:text-center [&_h2]:text-center [&_h3]:text-center [&_p]:text-center [&_li]:text-center"
    : align === "right"
      ? "text-right [&_h1]:text-right [&_h2]:text-right [&_h3]:text-right [&_p]:text-right [&_li]:text-right"
      : undefined;
const compact = (spacing ?? "xl") === "none";
const anchorId = sec?.anchor_id ? slugifyAnchor(sec.anchor_id) : undefined;
---

<Section
  tone={tone}
  spacing={spacing}
  id={anchorId}
  data-richtext-compact={compact ? "" : undefined}
>
  <Container width={containerWidth} class={alignClass} data-reveal>
    <Prose class:list={[alignClass, isWide && "max-w-none"]}>
      <div set:html={html} />
    </Prose>
    {showCta && (
      <div
        class:list={[
          "mt-[var(--content-rhythm-lg)] flex flex-wrap gap-3",
          align === "center" && "justify-center",
          align === "right" && "justify-end",
        ]}
      >
        {cta_primary && <CtaLink link={cta_primary} variant="primary" />}
        {cta_secondary && <CtaLink link={cta_secondary} variant="secondary" />}
      </div>
    )}
  </Container>
</Section>
