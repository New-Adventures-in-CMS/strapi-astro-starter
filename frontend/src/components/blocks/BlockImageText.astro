---
import type {
  AspectRatio,
  ImageFit,
  SharedSection,
  SharedContainer,
  StrapiMedia,
  SharedLink,
} from "@/types";
import { Section, Container } from "@/components/layout";
import { Prose } from "@/components/starwind/prose";
import SectionHeader from "@/components/SectionHeader.astro";
import CtaLink from "@/components/CtaLink.astro";
import { renderMarkdown } from "@/lib/markdown";
import StrapiImage from "@/components/StrapiImage.astro";
import { imageText } from "./variants";
import { slugifyAnchor } from "@/lib/links";

interface Props {
  heading?: string | null;
  eyebrow?: string | null;
  body: string;
  cta_primary?: SharedLink | null;
  cta_secondary?: SharedLink | null;
  image?: StrapiMedia | null;
  image_position: "left" | "right";
  image_fit?: ImageFit;
  aspect_ratio?: AspectRatio;
  section?: SharedSection;
  container?: SharedContainer;
}

const {
  heading,
  eyebrow,
  body,
  cta_primary,
  cta_secondary,
  image,
  image_position = "left",
  image_fit = "cover",
  aspect_ratio = "4:3",
  section: sec,
  container,
} = Astro.props;

const showCta = cta_primary || cta_secondary;
const tone = sec?.tone ?? "default";
const spacing = sec?.spacing ?? "xl";
const width = container?.width ?? "contained";
const anchorId = sec?.anchor_id ? slugifyAnchor(sec.anchor_id) : undefined;
const html = renderMarkdown(body);
const cv = imageText({
  width,
  aspectRatio: aspect_ratio,
  imageFit: image_fit,
  imagePosition: image_position,
});
---

<Section tone={tone} spacing={spacing} id={anchorId}>
  <Container width={width}>
    <div class={cv.grid()} data-reveal="stagger">
      <div class={cv.imageCol()} data-mask-skip>
        {image ? (
          <div
            data-mask-reveal
            data-parallax={image_fit !== "contain" ? "" : undefined}
            class:list={["overflow-hidden", cv.image()]}
          >
            <StrapiImage
              image={image}
              alt={image.alternativeText || heading || ""}
              sizes="(min-width: 768px) 50vw, 100vw"
              class={`w-full h-full ${image_fit === "contain" ? "object-contain object-center" : "object-cover object-center"}`}
              loadingIndicator="blur"
            />
          </div>
        ) : (
          <div class:list={[cv.image(), "bg-muted border border-border/40"]} />
        )}
      </div>
      <div class={cv.textCol()} data-stagger-skip>
        <div>
          <SectionHeader eyebrow={eyebrow} heading={heading} gap="md" />
          <Prose>
            <div set:html={html} data-reveal />
          </Prose>
          {showCta && (
            <div class="mt-[var(--content-rhythm-lg)] flex flex-wrap gap-3" data-reveal>
              {cta_primary && <CtaLink link={cta_primary} variant="primary" />}
              {cta_secondary && <CtaLink link={cta_secondary} variant="secondary" />}
            </div>
          )}
        </div>
      </div>
    </div>
  </Container>
</Section>
