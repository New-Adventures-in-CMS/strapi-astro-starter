---
import type { StrapiMedia } from "@/types";
import { Section, Container } from "@/components/layout";
import { Prose } from "@/components/starwind/prose";
import SectionHeader from "@/components/SectionHeader.astro";
import { renderMarkdown } from "@/lib/markdown";
import { strapiMediaUrl } from "@/lib/strapi";

interface Props {
  heading?: string | null;
  eyebrow?: string | null;
  body: string;
  image?: StrapiMedia | null;
  image_position: "left" | "right";
}

const { heading, eyebrow, body, image, image_position } = Astro.props;
const imageUrl = image ? strapiMediaUrl(image.url) : null;
const html = renderMarkdown(body);
const isImageLeft = image_position === "left";
---

<Section spacing="default">
  <Container width="wide">
    <div
      class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16 items-center"
    >
      <div class={isImageLeft ? "md:order-1" : "md:order-2"}>
        {imageUrl ? (
          <img
            src={imageUrl}
            alt={image?.alternativeText || heading || ""}
            class="w-full rounded-lg object-cover aspect-[4/3]"
            width={image?.width}
            height={image?.height}
          />
        ) : (
          <div class="w-full aspect-[4/3] rounded-lg bg-muted border border-border/40" />
        )}
      </div>
      <div class={isImageLeft ? "md:order-2" : "md:order-1"}>
        <SectionHeader eyebrow={eyebrow} heading={heading} class="mb-0" />
        <Prose class={heading || eyebrow ? "mt-6" : ""}>
          <div set:html={html} />
        </Prose>
      </div>
    </div>
  </Container>
</Section>
