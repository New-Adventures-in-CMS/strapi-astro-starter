---
import type { AspectRatio, ImageFit, SharedSection, SharedContainer, StrapiMedia } from "@/types";
import { Section, Container } from "@/components/layout";
import { Prose } from "@/components/starwind/prose";
import SectionHeader from "@/components/SectionHeader.astro";
import { renderMarkdown } from "@/lib/markdown";
import StrapiImage from "@/components/StrapiImage.astro";
import { imageText } from "./variants";

interface Props {
  heading?: string | null;
  eyebrow?: string | null;
  body: string;
  image?: StrapiMedia | null;
  image_position: "left" | "right";
  image_fit?: ImageFit;
  aspect_ratio?: AspectRatio;
  section?: SharedSection;
  container?: SharedContainer;
}

const {
  heading,
  eyebrow,
  body,
  image,
  image_position = "left",
  image_fit = "cover",
  aspect_ratio = "4:3",
  section: sec,
  container,
} = Astro.props;

const tone = sec?.tone ?? "default";
const spacing = sec?.spacing ?? "xl";
const width = container?.width ?? "contained";
const html = renderMarkdown(body);
const cv = imageText({
  width,
  aspectRatio: aspect_ratio,
  imageFit: image_fit,
  imagePosition: image_position,
});
---

<Section tone={tone} spacing={spacing}>
  <Container width={width}>
    <div class={cv.grid()} data-reveal="stagger">
      <div class={cv.imageCol()} data-mask-skip>
        {image ? (
          <div data-mask-reveal class:list={["overflow-hidden", cv.image()]}>
            <StrapiImage
              image={image}
              alt={image.alternativeText || heading || ""}
              sizes="(min-width: 768px) 50vw, 100vw"
              class={`w-full h-full ${image_fit === "contain" ? "object-contain object-center" : "object-cover object-center"}`}
              loadingIndicator="blur"
            />
          </div>
        ) : (
          <div class:list={[cv.image(), "bg-muted border border-border/40"]} />
        )}
      </div>
      <div class={cv.textCol()}>
        <SectionHeader eyebrow={eyebrow} heading={heading} class="mb-0" />
        <Prose class={heading || eyebrow ? "mt-6" : ""}>
          <div set:html={html} />
        </Prose>
      </div>
    </div>
  </Container>
</Section>
