---
import type { BlockWidth, SectionSpacing, StrapiMedia } from "@/types";
import { Section, Container } from "@/components/layout";
import { Prose } from "@/components/starwind/prose";
import SectionHeader from "@/components/SectionHeader.astro";
import { renderMarkdown } from "@/lib/markdown";
import StrapiImage from "@/components/StrapiImage.astro";
import { imageText } from "./variants";

interface Props {
  heading?: string | null;
  eyebrow?: string | null;
  body: string;
  image?: StrapiMedia | null;
  image_position: "left" | "right";
  width?: BlockWidth;
  spacing?: SectionSpacing;
}

const {
  heading,
  eyebrow,
  body,
  image,
  image_position = "left",
  width = "contained",
  spacing = "xl",
} = Astro.props;

const html = renderMarkdown(body);
const cv = imageText({ width, imagePosition: image_position });
---

<Section spacing={spacing}>
  <Container width={width}>
    <div class={cv.grid()} data-reveal="stagger">
      <div class={cv.imageCol()} data-mask-skip>
        {image ? (
          <div data-mask-reveal class:list={["overflow-hidden", cv.image()]}>
            <StrapiImage
              image={image}
              alt={image.alternativeText || heading || ""}
              sizes="(min-width: 768px) 50vw, 100vw"
              class="w-full h-full object-cover"
            />
          </div>
        ) : (
          <div class:list={[cv.image(), "bg-muted border border-border/40"]} />
        )}
      </div>
      <div class={cv.textCol()}>
        <SectionHeader eyebrow={eyebrow} heading={heading} class="mb-0" />
        <Prose class={heading || eyebrow ? "mt-6" : ""}>
          <div set:html={html} />
        </Prose>
      </div>
    </div>
  </Container>
</Section>
