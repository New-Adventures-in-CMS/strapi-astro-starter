---
import type { StrapiMedia } from "@/types";
import { Section, Container } from "@/components/layout";
import { Button } from "@/components/starwind/button";
import { strapiMediaUrl } from "@/lib/strapi";

interface Props {
  heading: string;
  subheading?: string | null;
  cta_text?: string | null;
  cta_url?: string | null;
  image?: StrapiMedia | null;
  eyebrow?: string | null;
}

const { heading, subheading, cta_text, cta_url, image, eyebrow } = Astro.props;
const imageUrl = image ? strapiMediaUrl(image.url) : null;
const showCta = cta_text && cta_url;
const altText = image?.alternativeText || "";
---

{
  imageUrl ? (
    // Hero with background image — full-bleed with overlay
    <Section
      tone="dark"
      spacing="none"
      class="relative overflow-hidden min-h-[70vh] md:min-h-[80vh] flex items-center justify-center"
    >
      {/* Full-width background image */}
      <img
        src={imageUrl}
        alt={altText}
        class="absolute inset-0 h-full w-full object-cover -z-10"
      />
      {/* Gradient overlay for text readability */}
      <div class="absolute inset-0 -z-10 bg-gradient-to-r from-black/70 via-black/50 to-black/30" />

      {/* Text content in centered container */}
      <Container width="default" class="relative text-center text-white">
        {eyebrow && (
          <p class="mb-4 text-xs uppercase tracking-[0.2em] text-white/70">
            {"{" + eyebrow + "}"}
          </p>
        )}
        <h1 class="font-heading uppercase text-balance">
          {heading}
        </h1>
        {subheading && (
          <p class="mt-6 text-lg md:text-xl text-white/80 max-w-2xl mx-auto leading-relaxed">
            {subheading}
          </p>
        )}
        {showCta && (
          <div class="mt-10">
            <Button
              variant="default"
              size="lg"
              href={cta_url}
              class="bg-white text-black hover:bg-white/90"
            >
              {cta_text}
            </Button>
          </div>
        )}
      </Container>
    </Section>
  ) : (
    // Hero without image — dark tone band with subtle gradient accent
    <Section
      tone="dark"
      spacing="none"
      class="relative overflow-hidden min-h-[70vh] md:min-h-[80vh] flex items-center justify-center"
    >
      {/* Subtle radial gradient accent for visual interest */}
      <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,rgba(255,255,255,0.08),transparent)]" />

      {/* Text content in centered container */}
      <Container width="default" class="relative text-center text-white">
        {eyebrow && (
          <p class="mb-4 text-xs uppercase tracking-[0.2em] text-white/70">
            {"{" + eyebrow + "}"}
          </p>
        )}
        <h1 class="font-heading uppercase text-balance">
          {heading}
        </h1>
        {subheading && (
          <p class="mt-6 text-lg md:text-xl text-white/80 max-w-2xl mx-auto leading-relaxed">
            {subheading}
          </p>
        )}
        {showCta && (
          <div class="mt-10">
            <Button
              variant="default"
              size="lg"
              href={cta_url}
              class="bg-white text-black hover:bg-white/90"
            >
              {cta_text}
            </Button>
          </div>
        )}
      </Container>
    </Section>
  )
}
