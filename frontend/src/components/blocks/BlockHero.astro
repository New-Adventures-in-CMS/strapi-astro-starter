---
import type { HeroSlide, StrapiMedia, HeroAlign, HeroStyle } from "@/types";
import { Section, Container } from "@/components/layout";
import { heroContent } from "@/components/layout/variants";
import { Button } from "@/components/starwind/button";
import { strapiMediaUrl } from "@/lib/strapi";
import { site } from "@/config/site";
import type { HeroTransition, HeroEffect } from "@/config/site";

interface Props {
  heading: string;
  subheading?: string | null;
  cta_text?: string | null;
  cta_url?: string | null;
  image?: StrapiMedia | null;
  eyebrow?: string | null;
  immersive?: boolean | null;
  slides?: HeroSlide[] | null;
  autoplayDelay?: number;
  transition?: HeroTransition;
  effect?: HeroEffect;
  align?: HeroAlign | null;
  heroStyle?: HeroStyle | null;
}

const {
  heading,
  subheading,
  cta_text,
  cta_url,
  image,
  eyebrow,
  immersive,
  slides,
  autoplayDelay = 5000,
  transition,
  effect,
  align,
  heroStyle,
} = Astro.props;

const HERO_PRESETS: Record<HeroStyle, { transition: HeroTransition; effect: HeroEffect }> = {
  fade: { transition: "fade", effect: "none" },
  slide: { transition: "slide", effect: "none" },
  drift: { transition: "slide", effect: "drift" },
  focus: { transition: "slide", effect: "focus" },
  dim: { transition: "slide", effect: "dim" },
  parallax: { transition: "fade", effect: "parallax" },
  tilt: { transition: "fade", effect: "tilt" },
  "ken-burns": { transition: "fade", effect: "ken-burns" },
};
const presetPair = HERO_PRESETS[heroStyle ?? site.heroStyle];
const heroTransition: HeroTransition = transition ?? presetPair.transition;
const requestedEffect: HeroEffect = effect ?? presetPair.effect;
const blockAlign: HeroAlign = align ?? site.heroAlign;
const SCROLL_EFFECTS: HeroEffect[] = ["drift", "focus", "dim"]; // pattern A → richiedono slide
const heroEffect: HeroEffect =
  SCROLL_EFFECTS.includes(requestedEffect) && heroTransition !== "slide" ? "none" : requestedEffect;
if (import.meta.env.DEV && heroEffect !== requestedEffect) {
  console.warn(
    `[BlockHero] effect "${requestedEffect}" richiede transition "slide" (attuale "${heroTransition}") → degradato a "none".`,
  );
}
const isDrift = heroEffect === "drift";
const multiSlide = slides && slides.length >= 2;

// Static display: first slide content or top-level fields
const staticSlide: HeroSlide =
  slides && slides.length >= 1
    ? slides[0]
    : { heading, eyebrow, subheading, cta_text, cta_url, image };

const staticAlign: HeroAlign = staticSlide.align ?? blockAlign;
const staticHC = heroContent({ align: staticAlign });

function slideImageUrl(s: HeroSlide) {
  return s.image ? strapiMediaUrl(s.image.url) : null;
}
---

<Section
  tone="dark"
  spacing="none"
  class:list={[
    `relative overflow-hidden flex ${staticHC.wrap()}`,
    immersive ? "min-h-[100svh]" : "min-h-[70vh] md:min-h-[80vh]",
  ]}
  data-hero-static={multiSlide ? undefined : ""}
  data-hero-effect={multiSlide ? undefined : heroEffect}
>
  {multiSlide ? (
    /* ── CAROUSEL MODE ──────────────────────────────────────── */
    <div
      class="absolute inset-0"
      data-hero-carousel
      data-autoplay-delay={autoplayDelay}
      data-hero-transition={heroTransition}
      data-hero-effect={heroEffect}
      tabindex="0"
    >
      {/* Embla viewport — overflow:hidden + explicit h-full so Embla can measure */}
      <div class="overflow-hidden h-full" data-carousel-viewport>
        <div class="flex h-full touch-pan-y">
          {slides.map((slide) => {
            const imgUrl = slideImageUrl(slide);
            const showCta = slide.cta_text && slide.cta_url;
            const a: HeroAlign = slide.align ?? blockAlign;
            const hc = heroContent({ align: a });
            return (
              <div
                class={`relative flex-[0_0_100%] h-full flex ${hc.wrap()} overflow-hidden`}
                data-hero-slide
              >
                {imgUrl ? (
                  <>
                    {isDrift ? (
                      <div class="hero-slide__parallax" data-parallax-layer data-hero-media>
                        <img
                          src={imgUrl}
                          alt={slide.image?.alternativeText || ""}
                          class="absolute inset-0 h-full w-full object-cover"
                        />
                      </div>
                    ) : (
                      <img
                        src={imgUrl}
                        alt={slide.image?.alternativeText || ""}
                        class="absolute inset-0 h-full w-full object-cover"
                        data-hero-media
                      />
                    )}
                    <div class="absolute inset-0 bg-gradient-to-r from-[var(--section-dark-overlay-from)] via-[var(--section-dark-overlay-via)] to-[var(--section-dark-overlay-to)]" />
                  </>
                ) : isDrift ? (
                  <div class="hero-slide__parallax" data-parallax-layer data-hero-media>
                    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,var(--section-dark-accent),transparent)]" />
                  </div>
                ) : (
                  <div
                    class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,var(--section-dark-accent),transparent)]"
                    data-hero-media
                  />
                )}
                <Container
                  width="default"
                  class={`relative z-10 py-24 ${hc.text()}`}
                  data-hero-content
                >
                  {slide.eyebrow && (
                    <p class="mb-4 text-xs uppercase tracking-[0.2em] text-[var(--section-dark-fg-subtle)]">
                      {slide.eyebrow}
                    </p>
                  )}
                  <h1 class="font-heading uppercase text-balance text-[var(--section-dark-fg)]">
                    {slide.heading}
                  </h1>
                  {slide.subheading && (
                    <p
                      class:list={[
                        "mt-6 text-lg md:text-xl leading-relaxed text-[var(--section-dark-fg-muted)] max-w-2xl",
                        a.includes("left") && "mr-auto text-left",
                        a.includes("center") && "mx-auto text-center",
                        a.includes("right") && "ml-auto text-right",
                      ]}
                    >
                      {slide.subheading}
                    </p>
                  )}
                  {showCta && (
                    <div class="mt-10">
                      <Button
                        variant="default"
                        size="lg"
                        href={slide.cta_url}
                        class="bg-[var(--section-dark-cta-bg)] text-[var(--section-dark-cta-fg)] hover:bg-[var(--section-dark-cta-bg-hover)]"
                      >
                        {slide.cta_text}
                      </Button>
                    </div>
                  )}
                </Container>
              </div>
            );
          })}
        </div>
      </div>

      {/* Prev arrow */}
      <button
        class="hero-carousel-arrow absolute left-4 top-1/2 -translate-y-1/2 z-20 rounded-full p-2"
        data-carousel-prev
        type="button"
      >
        <svg
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 19l-7-7 7-7"
          />
        </svg>
      </button>

      {/* Next arrow */}
      <button
        class="hero-carousel-arrow absolute right-4 top-1/2 -translate-y-1/2 z-20 rounded-full p-2"
        data-carousel-next
        type="button"
      >
        <svg
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      {/* Dots container — skeleton populates with <button> elements */}
      <div
        class="absolute bottom-8 left-0 right-0 z-20 flex justify-center gap-3"
        data-carousel-dots
      ></div>
    </div>
  ) : (
    /* ── STATIC MODE (single slide or top-level fields) ─────── */
    <>
      {slideImageUrl(staticSlide) ? (
        <>
          <img
            src={slideImageUrl(staticSlide)!}
            alt={staticSlide.image?.alternativeText || ""}
            class="absolute inset-0 h-full w-full object-cover"
            data-hero-media
          />
          <div class="absolute inset-0 bg-gradient-to-r from-[var(--section-dark-overlay-from)] via-[var(--section-dark-overlay-via)] to-[var(--section-dark-overlay-to)]" />
        </>
      ) : (
        <div
          class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,var(--section-dark-accent),transparent)]"
          data-hero-media
        />
      )}

      <Container width="default" class={`relative z-10 ${staticHC.text()}`} data-hero-content>
        {staticSlide.eyebrow && (
          <p class="mb-4 text-xs uppercase tracking-[0.2em] text-[var(--section-dark-fg-subtle)]">
            {staticSlide.eyebrow}
          </p>
        )}
        <h1 class="font-heading uppercase text-balance text-[var(--section-dark-fg)]">
          {staticSlide.heading}
        </h1>
        {staticSlide.subheading && (
          <p
            class:list={[
              "mt-6 text-lg md:text-xl leading-relaxed text-[var(--section-dark-fg-muted)] max-w-2xl",
              staticAlign.includes("left") && "mr-auto text-left",
              staticAlign.includes("center") && "mx-auto text-center",
              staticAlign.includes("right") && "ml-auto text-right",
            ]}
          >
            {staticSlide.subheading}
          </p>
        )}
        {staticSlide.cta_text && staticSlide.cta_url && (
          <div class="mt-10">
            <Button
              variant="default"
              size="lg"
              href={staticSlide.cta_url}
              class="bg-[var(--section-dark-cta-bg)] text-[var(--section-dark-cta-fg)] hover:bg-[var(--section-dark-cta-bg-hover)]"
            >
              {staticSlide.cta_text}
            </Button>
          </div>
        )}
      </Container>
    </>
  )}

  {immersive && (
    <div
      id="header-overlay-sentinel"
      class="pointer-events-none absolute bottom-0 h-px w-full z-30"
      aria-hidden="true"
    ></div>
  )}
</Section>

<style is:global>
  .hero-slide__parallax {
    position: absolute;
    top: 0;
    bottom: 0;
    left: -10%;
    right: -10%;
    will-change: transform;
  }
  .hero-carousel-arrow {
    background: color-mix(in srgb, var(--section-dark-fg) 15%, transparent);
    color: var(--section-dark-fg);
    backdrop-filter: blur(4px);
    transition: background 0.15s;
  }
  .hero-carousel-arrow:hover {
    background: color-mix(in srgb, var(--section-dark-fg) 30%, transparent);
  }
  .hero-carousel-arrow:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }
  [data-hero-carousel] [data-carousel-dots] button {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--section-dark-fg);
    opacity: 0.4;
    border: none;
    cursor: pointer;
    transition:
      opacity 0.2s,
      transform 0.2s;
  }
  [data-hero-carousel] [data-carousel-dots] button[data-active] {
    opacity: 1;
    transform: scale(1.25);
  }
</style>

<script>
  import { createCarousel } from "@skeleton/carousel.js";
  import { setupHeroDrift } from "@/lib/hero-drift.js";
  import { setupHeroParallax } from "@/lib/hero-parallax.js";
  import { setupHeroTilt } from "@/lib/hero-tilt.js";
  import { setupHeroFocus } from "@/lib/hero-focus.js";
  import { setupHeroDim } from "@/lib/hero-dim.js";
  import { setupHeroKenBurns } from "@/lib/hero-ken-burns.js";

  document.querySelectorAll<HTMLElement>("[data-hero-static]").forEach((root) => {
    const heroEffect = root.dataset.heroEffect ?? "none";
    if (heroEffect === "tilt") {
      const cleanup = setupHeroTilt(root);
      document.addEventListener("astro:before-swap", cleanup, { once: true });
    }
  });

  document.querySelectorAll<HTMLElement>("[data-hero-carousel]").forEach((root) => {
    const prevBtn = root.querySelector<HTMLElement>("[data-carousel-prev]") ?? undefined;
    const nextBtn = root.querySelector<HTMLElement>("[data-carousel-next]") ?? undefined;
    const dots = root.querySelector<HTMLElement>("[data-carousel-dots]") ?? undefined;
    const delay = parseInt(root.dataset.autoplayDelay ?? "5000", 10);
    const heroTransition = (root.dataset.heroTransition ?? "fade") as "slide" | "fade";
    const heroEffect = (root.dataset.heroEffect ?? "none") as
      "none" | "drift" | "parallax" | "tilt" | "focus" | "dim" | "ken-burns";

    const api = createCarousel(root, {
      loop: true,
      autoplay: { delayMs: delay },
      prevBtn,
      nextBtn,
      dots,
      ...(heroTransition === "fade" ? { transition: "fade" as const } : {}),
    });

    if (heroEffect === "drift") {
      const cleanup = setupHeroDrift(api, root);
      document.addEventListener("astro:before-swap", cleanup, { once: true });
    }
    if (heroEffect === "parallax") {
      const cleanup = setupHeroParallax(api, root);
      document.addEventListener("astro:before-swap", cleanup, { once: true });
    }
    if (heroEffect === "tilt") {
      const cleanup = setupHeroTilt(root);
      document.addEventListener("astro:before-swap", cleanup, { once: true });
    }
    if (heroEffect === "focus") {
      const cleanup = setupHeroFocus(api, root);
      document.addEventListener("astro:before-swap", cleanup, { once: true });
    }
    if (heroEffect === "dim") {
      const cleanup = setupHeroDim(api, root);
      document.addEventListener("astro:before-swap", cleanup, { once: true });
    }
    if (heroEffect === "ken-burns") {
      const cleanup = setupHeroKenBurns(api, root);
      document.addEventListener("astro:before-swap", cleanup, { once: true });
    }
  });
</script>
