---
import type { StrapiMedia } from "@/types";
import { Section, Container } from "@/components/layout";
import { Button } from "@/components/starwind/button";
import { strapiMediaUrl } from "@/lib/strapi";

interface Props {
  heading: string;
  subheading?: string | null;
  cta_text?: string | null;
  cta_url?: string | null;
  image?: StrapiMedia | null;
  eyebrow?: string | null;
  immersive?: boolean | null;
}

const { heading, subheading, cta_text, cta_url, image, eyebrow, immersive } = Astro.props;
const imageUrl = image ? strapiMediaUrl(image.url) : null;
const showCta = cta_text && cta_url;
const altText = image?.alternativeText || "";
---

<Section
  tone="dark"
  spacing="none"
  class:list={[
    "relative overflow-hidden flex items-center justify-center",
    immersive ? "min-h-[100svh]" : "min-h-[70vh] md:min-h-[80vh]",
  ]}
>
  {imageUrl ? (
    <>
      <img
        src={imageUrl}
        alt={altText}
        class="absolute inset-0 h-full w-full object-cover"
      />
      <div
        class="absolute inset-0 bg-gradient-to-r from-[var(--section-dark-overlay-from)] via-[var(--section-dark-overlay-via)] to-[var(--section-dark-overlay-to)]"
      />
    </>
  ) : (
    <div
      class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,var(--section-dark-accent),transparent)]"
    />
  )}

  <Container width="default" class="relative z-10 text-center">
    {eyebrow && (
      <p class="mb-4 text-xs uppercase tracking-[0.2em] text-[var(--section-dark-fg-subtle)]">
        {eyebrow}
      </p>
    )}
    <h1 class="font-heading uppercase text-balance text-[var(--section-dark-fg)]">
      {heading}
    </h1>
    {subheading && (
      <p class="mt-6 text-lg md:text-xl leading-relaxed text-[var(--section-dark-fg-muted)] max-w-2xl mx-auto">
        {subheading}
      </p>
    )}
    {showCta && (
      <div class="mt-10">
        <Button
          variant="default"
          size="lg"
          href={cta_url}
          class="bg-[var(--section-dark-cta-bg)] text-[var(--section-dark-cta-fg)] hover:bg-[var(--section-dark-cta-bg-hover)]"
        >
          {cta_text}
        </Button>
      </div>
    )}
  </Container>

  {immersive && (
    <div id="header-overlay-sentinel" class="pointer-events-none absolute bottom-0 h-px w-full" aria-hidden="true"></div>
  )}
</Section>
