---
import type { SharedSection } from "@/types";
import { Section, Container } from "@/components/layout";
import DynamicForm from "@/components/DynamicForm.astro";

interface Props {
  form?: { slug: string } | null;
  section?: SharedSection;
}

const { form, section: sec } = Astro.props;
const tone = sec?.tone ?? "default";
const spacing = sec?.spacing ?? "xl";
---

{form?.slug && (
  <Section tone={tone} spacing={spacing}>
    <Container width="prose">
      <DynamicForm slug={form.slug} />
    </Container>
  </Section>
)}
