---
import type { SectionSpacing, SharedBackground } from "@/types";
import { Section, Container } from "@/components/layout";
import DynamicForm from "@/components/DynamicForm.astro";

interface Props {
  form?: { slug: string } | null;
  spacing?: SectionSpacing;
  background?: SharedBackground;
}

const { form, spacing, background } = Astro.props;
const tone = background?.tone ?? "default";
---

{form?.slug && (
  <Section tone={tone} spacing={spacing ?? "xl"}>
    <Container width="prose">
      <DynamicForm slug={form.slug} />
    </Container>
  </Section>
)}
