---
import type { ReadingWidth, SharedSection } from "@/types";
import { Section, Container } from "@/components/layout";
import SectionHeader from "@/components/SectionHeader.astro";
import DynamicForm from "@/components/DynamicForm.astro";

interface Props {
  eyebrow?: string | null;
  heading?: string | null;
  lead?: string | null;
  reading_width?: ReadingWidth | null;
  form?: { slug: string } | null;
  section?: SharedSection;
}

const { eyebrow, heading, lead, reading_width, form, section: sec } = Astro.props;
const containerWidth = reading_width === "wide" ? "reading-wide" : "prose";
const tone = sec?.tone ?? "default";
const spacing = sec?.spacing ?? "xl";
const onDark = tone === "dark";
---

{form?.slug && (
  <Section tone={tone} spacing={spacing}>
    <Container width={containerWidth}>
      <SectionHeader
        eyebrow={eyebrow}
        heading={heading}
        lead={lead}
        align="center"
        onDark={onDark}
      />
      <DynamicForm slug={form.slug} />
    </Container>
  </Section>
)}
