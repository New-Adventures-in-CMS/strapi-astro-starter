---
import type { FaqItem, ReadingWidth, SharedSection } from "@/types";
import { Section, Container } from "@/components/layout";
import SectionHeader from "@/components/SectionHeader.astro";
import { Prose } from "@/components/starwind/prose";
import {
  Accordion,
  AccordionItem,
  AccordionContent,
  AccordionTrigger,
} from "@/components/starwind/accordion";
import { renderMarkdown } from "@/lib/markdown";
import { slugifyAnchor } from "@/lib/links";

interface Props {
  eyebrow?: string | null;
  heading?: string | null;
  reading_width?: ReadingWidth | null;
  items: FaqItem[];
  section?: SharedSection;
}

const { eyebrow, heading, reading_width, items, section: sec } = Astro.props;
const containerWidth = reading_width === "wide" ? "reading-wide" : "prose";
const tone = sec?.tone ?? "default";
const spacing = sec?.spacing ?? "xl";
const onDark = tone === "dark";
const anchorId = sec?.anchor_id ? slugifyAnchor(sec.anchor_id) : undefined;
---

<Section tone={tone} spacing={spacing} id={anchorId}>
  <Container width={containerWidth}>
    <SectionHeader eyebrow={eyebrow} heading={heading} align="center" onDark={onDark} />
    <div data-reveal>
      <Accordion type="single" collapsible>
        {items.map((item, i) => (
          <AccordionItem value={`faq-${i}`}>
            <h3>
              <AccordionTrigger>{item.question}</AccordionTrigger>
            </h3>
            <AccordionContent>
              <Prose class="max-w-none">
                <div set:html={renderMarkdown(item.answer)} />
              </Prose>
            </AccordionContent>
          </AccordionItem>
        ))}
      </Accordion>
    </div>
  </Container>
</Section>
