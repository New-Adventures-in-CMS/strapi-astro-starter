---
import type { PageBlock } from "@/types";
import { isBlockShown } from "@/lib/blocks";
import BlockHeroStatic from "./BlockHeroStatic.astro";
import BlockHeroSlider from "./BlockHeroSlider.astro";
import BlockRichText from "./BlockRichText.astro";
import BlockImageText from "./BlockImageText.astro";
import BlockCardGrid from "./BlockCardGrid.astro";
import BlockCarousel from "./BlockCarousel.astro";
import BlockForm from "./BlockForm.astro";
import BlockGallery from "./BlockGallery.astro";
import BlockFaq from "./BlockFaq.astro";

interface Props {
  blocks: PageBlock[];
}

const { blocks } = Astro.props;
---

{blocks.filter(isBlockShown).map((block) => {
  switch (block.__component) {
    case "blocks.hero-static":
      return <BlockHeroStatic {...block} />;
    case "blocks.hero-slider":
      return <BlockHeroSlider {...block} />;
    case "blocks.rich-text":
      return <BlockRichText {...block} />;
    case "blocks.image-text":
      return <BlockImageText {...block} />;
    case "blocks.card-grid":
      return <BlockCardGrid {...block} />;
    case "blocks.carousel":
      return <BlockCarousel {...block} />;
    case "blocks.form":
      return <BlockForm {...block} />;
    case "blocks.gallery":
      return <BlockGallery {...block} />;
    case "blocks.faq":
      return <BlockFaq {...block} />;
    default:
      return null;
  }
})}
