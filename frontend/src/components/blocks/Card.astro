---
import type { SharedCard } from "@/types";
import {
  Card as UICard,
  CardHeader,
  CardTitle,
  CardDescription,
  CardFooter,
} from "@/components/starwind/card";
import { Button } from "@/components/starwind/button";
import { strapiMediaUrl } from "@/lib/strapi";

interface Props {
  card: SharedCard;
  onDark?: boolean;
  index?: number;
}

const { card, onDark = false, index } = Astro.props;
const imageUrl = card.image ? strapiMediaUrl(card.image.url) : null;
const idx = index != null ? String(index).padStart(2, "0") : null;
---

<UICard class={onDark ? "bg-background/80 border-border/50" : ""}>
  {imageUrl ? (
    <img
      src={imageUrl}
      alt={card.image?.alternativeText || card.title || ""}
      class="w-full rounded-t-lg object-cover aspect-video"
      width={card.image?.width}
      height={card.image?.height}
    />
  ) : (
    <div
      class="w-full rounded-t-lg aspect-video flex items-center justify-center bg-muted/40 text-muted-foreground"
      aria-hidden="true"
    >
      <svg
        class="h-12 w-12 fill-current opacity-60"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M21 5v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2zM5 19h14l-4.5-6-3.5 4.5L8.5 14 5 19zM8.5 10.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z" />
      </svg>
    </div>
  )}
  <CardHeader>
    {idx && <p class="text-xs tracking-[0.2em] text-muted-foreground mb-2">({idx})</p>}
    {card.eyebrow && (
      <p class="text-xs uppercase tracking-[0.2em] text-muted-foreground mb-2">{card.eyebrow}</p>
    )}
    <CardTitle>{card.title}</CardTitle>
    {card.description && <CardDescription>{card.description}</CardDescription>}
  </CardHeader>
  {card.link_url && card.link_text && (
    <CardFooter>
      <Button variant="ghost" size="sm" href={card.link_url}>
        {card.link_text}
      </Button>
    </CardFooter>
  )}
</UICard>
