---
import type { SharedCard, AspectRatio, CtaStyle } from "@/types";
import { Card as UICard, CardHeader, CardTitle, CardDescription } from "@/components/starwind/card";
import StrapiImage from "@/components/StrapiImage.astro";
import { aspectRatioClass, ctaStyleClass } from "./variants";

interface Props {
  card: SharedCard;
  onDark?: boolean;
  index?: number;
  aspectRatio?: AspectRatio;
  ctaStyle?: CtaStyle;
}

const { card, onDark = false, index, aspectRatio = "16:9", ctaStyle = "button" } = Astro.props;
const arClass = aspectRatioClass[aspectRatio];
const hasImage = card.image != null;
const hasMaskReveal = hasImage && index != null;
const isFullCard = ctaStyle === "full_card";
const hasCta = !!(card.link_url && card.link_text);
const clickable = isFullCard && hasCta;
const zoomClass = clickable && hasImage ? ctaStyleClass.full_card.image : "";
const cardClass = [
  onDark && "bg-background/80 border-border/50",
  hasMaskReveal && "pt-0",
  ctaStyleClass[ctaStyle].card,
  clickable && "cursor-pointer",
]
  .filter(Boolean)
  .join(" ");
---

<UICard class={cardClass}>
  {hasImage ? (
    hasMaskReveal ? (
      <div
        data-mask-reveal
        class="overflow-hidden rounded-t-xl"
        style={`--mask-delay:${index! * 100}ms`}
      >
        <StrapiImage
          image={card.image}
          alt={card.image?.alternativeText || card.title || ""}
          sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
          class={`w-full object-cover ${arClass} ${zoomClass}`}
          loadingIndicator="blur"
        />
      </div>
    ) : (
      <div class="overflow-hidden rounded-t-lg">
        <StrapiImage
          image={card.image}
          alt={card.image?.alternativeText || card.title || ""}
          sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
          class={`w-full object-cover ${arClass} ${zoomClass}`}
          loadingIndicator="blur"
        />
      </div>
    )
  ) : (
    <div
      class={`w-full rounded-t-lg ${arClass} flex items-center justify-center bg-muted/40 text-muted-foreground`}
      aria-hidden="true"
    >
      <svg
        class="h-12 w-12 fill-current opacity-60"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M21 5v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2zM5 19h14l-4.5-6-3.5 4.5L8.5 14 5 19zM8.5 10.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z" />
      </svg>
    </div>
  )}
  <CardHeader>
    {card.eyebrow && (
      <p class="text-xs uppercase tracking-[0.2em] text-muted-foreground mb-2">{card.eyebrow}</p>
    )}
    <CardTitle>{card.title}</CardTitle>
    {card.description && <CardDescription>{card.description}</CardDescription>}
  </CardHeader>
  {!isFullCard && hasCta && (
    <div class="px-(--card-spacing) pb-1">
      <a
        href={card.link_url}
        class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors"
      >
        {card.link_text} &rarr;
      </a>
    </div>
  )}
  {clickable && (
    <a href={card.link_url} class="after:absolute after:inset-0 after:z-10">
      <span class="sr-only">{card.link_text}</span>
    </a>
  )}
</UICard>
