---
import type { SharedCard } from "@/types";
import { Card, CardHeader, CardTitle, CardDescription, CardFooter } from "@/components/starwind/card";
import { Button } from "@/components/starwind/button";
import { strapiMediaUrl } from "@/lib/strapi";

interface Props {
  heading?: string | null;
  cards: SharedCard[];
}

const { heading, cards } = Astro.props;
---

<section class="py-16 px-4">
  <div class="max-w-6xl mx-auto">
    {heading && (
      <h2 class="text-2xl sm:text-3xl font-semibold text-center mb-10 text-foreground">
        {heading}
      </h2>
    )}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {cards.map((card) => {
        const imageUrl = card.image ? strapiMediaUrl(card.image.url) : null;
        return (
          <Card>
            {imageUrl && (
              <img
                src={imageUrl}
                alt={card.image?.alternativeText || card.title || "Card image"}
                class="w-full rounded-t-lg object-cover aspect-video"
                width={card.image?.width}
                height={card.image?.height}
              />
            )}
            <CardHeader>
              <CardTitle>{card.title}</CardTitle>
              {card.description && (
                <CardDescription>{card.description}</CardDescription>
              )}
            </CardHeader>
            {(card.link_url && card.link_text) && (
              <CardFooter>
                <Button variant="ghost" size="sm" href={card.link_url}>
                  {card.link_text}
                </Button>
              </CardFooter>
            )}
          </Card>
        );
      })}
    </div>
  </div>
</section>
