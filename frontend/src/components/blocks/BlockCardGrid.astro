---
import type { SharedCard } from "@/types";
import { Section, Container } from "@/components/layout";
import SectionHeader from "@/components/SectionHeader.astro";
import Card from "./Card.astro";

interface Props {
  heading?: string | null;
  eyebrow?: string | null;
  lead?: string | null;
  tone?: "light" | "dark" | null;
  cards: SharedCard[];
  width?: "full" | "contained";
  spacing?: "none" | "sm" | "md" | "lg" | "xl";
}

const { heading, eyebrow, lead, tone, cards, width, spacing } = Astro.props;
const sectionTone = tone === "dark" ? "dark" : "default";
const onDark = sectionTone === "dark";
---

<Section tone={sectionTone} spacing={spacing ?? "lg"}>
  <Container width={width ?? "contained"}>
    <div data-reveal>
      <SectionHeader
        eyebrow={eyebrow}
        heading={heading}
        lead={lead}
        align="center"
        onDark={onDark}
      />
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-reveal="stagger">
      {cards.map((c) => (
        <Card card={c} onDark={onDark} />
      ))}
    </div>
  </Container>
</Section>
