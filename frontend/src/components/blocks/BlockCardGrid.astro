---
import type { SharedSection, SharedCard, SharedContainer, AspectRatio, CtaStyle } from "@/types";
import { Section, Container } from "@/components/layout";
import SectionHeader from "@/components/SectionHeader.astro";
import Card from "./Card.astro";

interface Props {
  heading?: string | null;
  eyebrow?: string | null;
  lead?: string | null;
  aspect_ratio?: AspectRatio;
  cta_style?: CtaStyle;
  cards: SharedCard[];
  section?: SharedSection;
  container?: SharedContainer;
}

const {
  heading,
  eyebrow,
  lead,
  aspect_ratio,
  cta_style,
  cards,
  section: sec,
  container,
} = Astro.props;
const aspectRatio = aspect_ratio ?? "16:9";
const ctaStyle = cta_style ?? "button";
const tone = sec?.tone ?? "default";
const spacing = sec?.spacing ?? "xl";
const width = container?.width ?? "contained";
const onDark = tone === "dark";
---

<Section tone={tone} spacing={spacing}>
  <Container width={width}>
    <div data-reveal>
      <SectionHeader
        eyebrow={eyebrow}
        heading={heading}
        lead={lead}
        align="center"
        onDark={onDark}
      />
    </div>
    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
      data-reveal="stagger"
      data-mask-grid
    >
      {cards.map((c, i) => (
        <Card card={c} onDark={onDark} index={i} aspectRatio={aspectRatio} ctaStyle={ctaStyle} />
      ))}
    </div>
  </Container>
</Section>
