---
import type {
  SharedSection,
  SharedCard,
  SharedContainer,
  AspectRatio,
  CtaStyle,
  SharedLink,
} from "@/types";
import { Section, Container } from "@/components/layout";
import SectionHeader from "@/components/SectionHeader.astro";
import CtaLink from "@/components/CtaLink.astro";
import Card from "./Card.astro";

interface Props {
  heading?: string | null;
  eyebrow?: string | null;
  lead?: string | null;
  aspect_ratio?: AspectRatio;
  cta_style?: CtaStyle;
  cards: SharedCard[];
  cta_primary?: SharedLink | null;
  cta_secondary?: SharedLink | null;
  section?: SharedSection;
  container?: SharedContainer;
}

const {
  heading,
  eyebrow,
  lead,
  aspect_ratio,
  cta_style,
  cards,
  cta_primary,
  cta_secondary,
  section: sec,
  container,
} = Astro.props;
const aspectRatio = aspect_ratio ?? "16:9";
const ctaStyle = cta_style ?? "button";
const tone = sec?.tone ?? "default";
const spacing = sec?.spacing ?? "xl";
const width = container?.width ?? "contained";
const onDark = tone === "dark";
const showCta = cta_primary || cta_secondary;
---

<Section tone={tone} spacing={spacing}>
  <Container width={width}>
    <SectionHeader eyebrow={eyebrow} heading={heading} lead={lead} align="center" onDark={onDark} />
    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
      data-reveal="stagger"
      data-mask-grid
    >
      {cards.map((c, i) => (
        <Card card={c} onDark={onDark} index={i} aspectRatio={aspectRatio} ctaStyle={ctaStyle} />
      ))}
    </div>
    {showCta && (
      <div
        class="mt-[var(--content-rhythm-xl)] flex flex-wrap justify-center gap-3"
        data-section-cta
        data-reveal
      >
        {cta_primary && <CtaLink link={cta_primary} variant="primary" />}
        {cta_secondary && <CtaLink link={cta_secondary} variant="secondary" />}
      </div>
    )}
  </Container>
</Section>
