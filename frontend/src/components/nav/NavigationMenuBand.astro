---
import NavigationMenuPrimitive from "@starwind-ui/astro/navigation-menu";
import type { HTMLAttributes } from "astro/types";
import NavigationMenuPopup from "../starwind/navigation-menu/NavigationMenuPopup.astro";
import NavigationMenuViewport from "../starwind/navigation-menu/NavigationMenuViewport.astro";
import { navigationMenu } from "../starwind/navigation-menu/variants";
import {
  navigationMenuBandPopup,
  navigationMenuBandViewport,
} from "./band-variants";

// Band-composition wrapper: Root + shared inline Popup>Viewport, no Portal/Positioner.
// Runtime requires only [data-sw-nav-menu-popup] and [data-sw-nav-menu-viewport];
// omitting Positioner disables floating placement (band is fixed-under-header, not anchored).

type Props = Omit<HTMLAttributes<"nav">, "defaultValue" | "onChange" | "value"> & {
  defaultValue?: string | null;
  value?: string | null;
  openDelay?: number;
  closeDelay?: number;
  closeOnEscape?: boolean;
  closeOnOutsideInteract?: boolean;
  orientation?: "horizontal" | "vertical";
  size?: "sm" | "md";
};

const {
  defaultValue = null,
  value,
  openDelay = 50,
  closeDelay = 150,
  closeOnEscape = true,
  closeOnOutsideInteract = true,
  orientation = "horizontal",
  size = "md",
  class: className,
  ...rest
} = Astro.props;
---

<NavigationMenuPrimitive.Root
  class={navigationMenu({ class: ["static!", className].filter(Boolean).join(" ") })}
  defaultValue={defaultValue}
  value={value}
  openDelay={openDelay}
  closeDelay={closeDelay}
  closeOnEscape={closeOnEscape}
  closeOnOutsideInteract={closeOnOutsideInteract}
  orientation={orientation}
  {...rest}
  data-size={size}
  data-slot="navigation-menu"
  data-layout="band"
>
  <slot />

  <NavigationMenuPopup
    class={navigationMenuBandPopup()}
    data-slot="navigation-menu-popup"
  >
    <NavigationMenuViewport
      class={navigationMenuBandViewport()}
      data-slot="navigation-menu-viewport"
    />
  </NavigationMenuPopup>
</NavigationMenuPrimitive.Root>
