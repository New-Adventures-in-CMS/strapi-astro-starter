---
import { strapiFind } from "@/lib/strapi";

interface Props {
  slug: string;
  className?: string;
}

const { slug, className = "" } = Astro.props;

type Larghezza = "full" | "half" | "third";

type Campo =
  | { __component: "form.campo-testo"; id: number; label: string; nome: string; placeholder?: string; required?: boolean; larghezza?: Larghezza }
  | { __component: "form.campo-email"; id: number; label: string; nome: string; placeholder?: string; required?: boolean; larghezza?: Larghezza }
  | { __component: "form.campo-textarea"; id: number; label: string; nome: string; placeholder?: string; righe?: number; required?: boolean; larghezza?: Larghezza }
  | { __component: "form.campo-select"; id: number; label: string; nome: string; opzioni: string; required?: boolean; larghezza?: Larghezza }
  | { __component: "form.campo-checkbox"; id: number; label: string; nome: string; required?: boolean; larghezza?: Larghezza };

interface FormDef {
  id: number;
  slug: string;
  nome: string;
  messaggioSuccesso?: string;
  campi: Campo[];
}

let formDef: FormDef | null = null;
let loadError = false;

try {
  const res = await strapiFind<FormDef>("forms", {
    filters: { slug: { $eq: slug } },
    populate: { campi: true },
  });
  formDef = res.data[0] ?? null;
} catch {
  loadError = true;
}

const inputClass =
  "w-full h-[44px] px-4 border border-gray-300 rounded text-[0.9375rem] font-[inherit] outline-none focus:border-blue-500";
const labelClass = "block text-[0.8125rem] font-medium mb-1";

function getSpan(larghezza?: Larghezza): string {
  if (larghezza === "half") return "col-span-3";
  if (larghezza === "third") return "col-span-2";
  return "col-span-6";
}
---

{loadError && (
  <p class="text-red-600 text-sm">Errore nel caricamento del form.</p>
)}

{!loadError && !formDef && (
  <p class="text-gray-400 text-sm">Form non trovato.</p>
)}

{formDef && (
  <div class={className}>
    <form id={"dform-" + slug} class="mt-4" novalidate data-slug={slug} data-success={formDef.messaggioSuccesso ?? "Grazie! Il tuo messaggio è stato inviato."}>
      <div class="grid grid-cols-6 gap-4 max-w-[640px]">

        {formDef.campi.map((campo) => {
          const id = "dform-" + slug + "-" + campo.nome;
          const req = campo.required ?? false;
          const span = getSpan(campo.larghezza);

          if (campo.__component === "form.campo-testo") {
            return (
              <div class={span}>
                <label for={id} class={labelClass}>{campo.label}{req && " *"}</label>
                <input id={id} type="text" name={campo.nome} placeholder={campo.placeholder ?? ""} required={req} class={inputClass} />
              </div>
            );
          }

          if (campo.__component === "form.campo-email") {
            return (
              <div class={span}>
                <label for={id} class={labelClass}>{campo.label}{req && " *"}</label>
                <input id={id} type="email" name={campo.nome} placeholder={campo.placeholder ?? ""} required={req} class={inputClass} />
              </div>
            );
          }

          if (campo.__component === "form.campo-textarea") {
            return (
              <div class={span}>
                <label for={id} class={labelClass}>{campo.label}{req && " *"}</label>
                <textarea id={id} name={campo.nome} placeholder={campo.placeholder ?? ""} rows={campo.righe ?? 5} required={req}
                  class="w-full px-4 py-3 border border-gray-300 rounded text-[0.9375rem] font-[inherit] outline-none focus:border-blue-500 resize-vertical" />
              </div>
            );
          }

          if (campo.__component === "form.campo-select") {
            const opts = (campo.opzioni ?? "").split("\n").map((o: string) => o.trim()).filter(Boolean);
            return (
              <div class={span}>
                <label for={id} class={labelClass}>{campo.label}{req && " *"}</label>
                <select id={id} name={campo.nome} required={req} class={inputClass + " bg-white cursor-pointer"}>
                  <option value="">— Seleziona —</option>
                  {opts.map((o: string) => <option value={o}>{o}</option>)}
                </select>
              </div>
            );
          }

          if (campo.__component === "form.campo-checkbox") {
            return (
              <div class={span + " flex items-start gap-2"}>
                <input id={id} type="checkbox" name={campo.nome} required={req} class="mt-[3px] w-4 h-4 flex-shrink-0" />
                <label for={id} class="text-[0.875rem] leading-[1.4] cursor-pointer">{campo.label}{req && " *"}</label>
              </div>
            );
          }

          return null;
        })}

        <input type="text" name="website" tabindex="-1" autocomplete="off" style="display:none" aria-hidden="true" />

        <div id={"dform-" + slug + "-error"} class="hidden col-span-6 text-[0.875rem] text-red-600 py-2"></div>

        <div class="col-span-6">
          <button type="submit"
            class="bg-blue-600 text-white border-0 px-8 h-[44px] rounded text-[0.875rem] font-medium cursor-pointer transition-opacity hover:opacity-90 disabled:opacity-50 disabled:cursor-not-allowed">
            Invia
          </button>
        </div>
      </div>
    </form>

    <div id={"dform-" + slug + "-success"} class="hidden mt-6 max-w-[640px] bg-green-50 border border-green-200 rounded p-5">
      <p class="m-0 font-medium text-green-700" id={"dform-" + slug + "-success-msg"}></p>
    </div>
  </div>
)}

<script>
  import { PUBLIC_STRAPI_URL } from "astro:env/client";

  document.querySelectorAll<HTMLFormElement>("form[data-slug]").forEach((form) => {
    const slug = form.dataset.slug!;
    const successMsg = form.dataset.success!;
    const submitBtn = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const errorEl = document.getElementById(`dform-${slug}-error`)!;
    const successEl = document.getElementById(`dform-${slug}-success`)!;
    const successMsgEl = document.getElementById(`dform-${slug}-success-msg`)!;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const honeypot = (form.querySelector<HTMLInputElement>("[name=website]")?.value ?? "");
      if (honeypot) return;

      submitBtn.disabled = true;
      submitBtn.textContent = "Invio in corso…";
      errorEl.className = "hidden";

      const formData = new FormData(form);
      const data: Record<string, string> = {};
      formData.forEach((v, k) => { if (k !== "website") data[k] = String(v); });

      try {
        const strapiUrl = PUBLIC_STRAPI_URL ?? "http://localhost:1337";
        const res = await fetch(`${strapiUrl}/api/form-submissions/submit`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ formSlug: slug, data }),
        });
        const json = await res.json() as { success?: boolean; message?: string; error?: { message?: string } };

        if (json.success) {
          form.classList.add("hidden");
          successMsgEl.textContent = json.message ?? successMsg;
          successEl.classList.remove("hidden");
        } else {
          errorEl.textContent = json.error?.message ?? "Errore. Riprova più tardi.";
          errorEl.className = "col-span-6 text-[0.875rem] text-red-600 py-2";
          submitBtn.disabled = false;
          submitBtn.textContent = "Invia";
        }
      } catch {
        errorEl.textContent = "Errore di rete. Riprova più tardi.";
        errorEl.className = "col-span-6 text-[0.875rem] text-red-600 py-2";
        submitBtn.disabled = false;
        submitBtn.textContent = "Invia";
      }
    });
  });
</script>
