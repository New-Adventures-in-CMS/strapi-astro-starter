---
import { Picture, getImage } from "astro:assets";
import type { StrapiMedia } from "@/types";
import { strapiMediaUrl } from "@/lib/strapi";

interface Props {
  image: StrapiMedia | null | undefined;
  sizes: string;
  widths?: number[];
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
  class?: string;
  alt?: string;
  loadingIndicator?: "blur" | "spinner";
  wrapperClass?: string;
  [key: string]: unknown;
}

const DEFAULT_WIDTHS = [320, 640, 768, 1024, 1280, 1536, 1920, 2560];
const NOMINAL_WIDTH = 1920;
const NOMINAL_HEIGHT = 1080;

const {
  image,
  sizes,
  widths: widthsOverride,
  loading = "lazy",
  fetchpriority,
  class: className,
  alt,
  loadingIndicator,
  wrapperClass,
  ...rest
} = Astro.props;

if (!image) return;

const src = strapiMediaUrl(image.url);
if (!src) return;

const resolvedAlt = alt ?? image.alternativeText ?? "";

const isSvg =
  image.mime === "image/svg+xml" ||
  image.ext?.toLowerCase() === ".svg" ||
  image.url.toLowerCase().endsWith(".svg");

function dataAttrs(obj: Record<string, unknown>): Record<string, unknown> {
  const out: Record<string, unknown> = {};
  for (const [k, v] of Object.entries(obj)) {
    if (k.startsWith("data-")) out[k] = v;
  }
  return out;
}

const forwarded = dataAttrs(rest);

const intrinsicW = image.width ?? NOMINAL_WIDTH;
const intrinsicH = image.height ?? NOMINAL_HEIGHT;

const ladder = widthsOverride ?? DEFAULT_WIDTHS;
const cappedWidths = ladder.filter((w) => w <= intrinsicW);
if (!cappedWidths.includes(intrinsicW)) cappedWidths.push(intrinsicW);
cappedWidths.sort((a, b) => a - b);

const useBlur = loadingIndicator === "blur" && !isSvg;
const useSpinner = loadingIndicator === "spinner";
const hasWrapper = useBlur || useSpinner;

// wrapperClass controls position when it includes one; relative is the default
const wrapperHasPosition =
  !!wrapperClass && /\b(absolute|fixed|relative|sticky|static)\b/.test(wrapperClass);

let lqipSrc: string | undefined;
if (useBlur) {
  const lqipW = 32;
  const lqipH = Math.round((intrinsicH / intrinsicW) * lqipW);
  const lqip = await getImage({ src, width: lqipW, height: lqipH, format: "webp", quality: 20 });
  lqipSrc = lqip.src;
}
---

{hasWrapper ? (
  <div
    data-si-loading
    class:list={[!wrapperHasPosition && "relative", useBlur && "isolate", wrapperClass]}
  >
    {isSvg ? (
      <img
        src={src}
        width={image.width}
        height={image.height}
        alt={resolvedAlt}
        class={className}
        loading={loading}
        decoding="async"
        fetchpriority={fetchpriority}
        {...forwarded}
      />
    ) : (
      <Picture
        src={src}
        formats={["avif", "webp"]}
        width={intrinsicW}
        height={intrinsicH}
        widths={cappedWidths}
        sizes={sizes}
        alt={resolvedAlt}
        class={className}
        loading={loading}
        decoding="async"
        fetchpriority={fetchpriority}
        pictureAttributes={{ class: "contents" }}
        {...forwarded}
      />
    )}
    {useBlur && lqipSrc ? (
      <img
        src={lqipSrc}
        alt=""
        class="si-blur absolute inset-0 w-full h-full object-cover -z-10 pointer-events-none"
        aria-hidden="true"
        data-variant="blur"
        loading="eager"
        decoding="sync"
      />
    ) : useSpinner ? (
      <div
        class="si-indicator si-indicator--spinner absolute inset-0 pointer-events-none"
        aria-hidden="true"
        data-variant="spinner"
      />
    ) : null}
  </div>
) : isSvg ? (
  <img
    src={src}
    width={image.width}
    height={image.height}
    alt={resolvedAlt}
    class={className}
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
    {...forwarded}
  />
) : (
  <Picture
    src={src}
    formats={["avif", "webp"]}
    width={intrinsicW}
    height={intrinsicH}
    widths={cappedWidths}
    sizes={sizes}
    alt={resolvedAlt}
    class={className}
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
    pictureAttributes={{ class: "contents" }}
    {...forwarded}
  />
)}
