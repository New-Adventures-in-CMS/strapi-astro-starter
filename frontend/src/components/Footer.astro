---
import { getFooterNav } from "@/lib/navigation";
import { site } from "@/config/site";
import { Container } from "@/components/layout";
import { Separator } from "@/components/starwind/separator";

const footer = await getFooterNav();
---

<footer class="mt-auto">
  <Container width="wide" class="py-16 md:py-20">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      {footer.columns.map((col) => (
        <div>
          <h3 class="mb-4 text-sm font-semibold text-gray-900">{col.title}</h3>
          <ul class="space-y-2">
            {col.items.map((item) => (
              <li>
                <a
                  href={item.href}
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noopener noreferrer" : undefined}
                  class="text-sm text-gray-600 hover:text-black"
                >{item.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <Separator class="my-8" />
    <p class="text-xs text-gray-500">{site.footer.legal}</p>
  </Container>
</footer>
