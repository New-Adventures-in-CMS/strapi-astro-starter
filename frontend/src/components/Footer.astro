---
import { getFooterNav } from "@/lib/navigation";
import { getSiteSettings } from "@/lib/strapi";
import { site } from "@/config/site";
import { footerWrapper } from "@/components/layout";
import { Separator } from "@/components/starwind/separator";
import Logo from "@/components/Logo.astro";
import SocialLinks from "@/components/SocialLinks.astro";

const footer = await getFooterNav();
const { footerWidth, footerTone, companyName, vatNumber, address, socialLinks } =
  await getSiteSettings();
const styles = footerWrapper({ width: footerWidth, tone: footerTone });

const copyrightLine = companyName
  ? `© ${new Date().getFullYear()} ${companyName}`
  : site.footer.legal;
---

<footer class="mt-auto" data-footer-width={footerWidth} data-footer-tone={footerTone}>
  <div class={styles.root()}>
    {/* Zone 1: Brand block + Nav columns */}
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-[1fr_2fr]">
      {/* Brand block */}
      <div class="space-y-6">
        <Logo class="h-8 w-auto" />
        {address && (
          <p class={`${styles.link()} whitespace-pre-line text-sm leading-relaxed`}>{address}</p>
        )}
        {socialLinks.length > 0 && (
          <div>
            <p class={`${styles.legal()} mb-3`}>Seguici su</p>
            <SocialLinks links={socialLinks} />
          </div>
        )}
      </div>

      {/* Nav columns */}
      <div
        class:list={[
          "grid gap-8",
          footer.columns.length === 1 && "grid-cols-1",
          footer.columns.length === 2 && "grid-cols-2",
          footer.columns.length >= 3 && "grid-cols-2 md:grid-cols-3",
        ]}
      >
        {footer.columns.map((col) => (
          <div>
            <h3 class={styles.title()}>{col.title}</h3>
            <ul class="space-y-2">
              {col.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    target={item.external ? "_blank" : undefined}
                    rel={item.external ? "noopener noreferrer" : undefined}
                    class={styles.link()}
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    {/* Zone 2: Separator */}
    <Separator class={styles.separator()} />

    {/* Zone 3: Legal bar */}
    <div class="flex flex-col gap-2 text-xs md:flex-row md:items-center md:gap-6">
      <span class={styles.legal()}>{copyrightLine}</span>
      {vatNumber && <span class={styles.legal()}>P.IVA {vatNumber}</span>}
      {footer.legal.length > 0 && (
        <nav class="flex flex-wrap gap-4" aria-label="Link legali">
          {footer.legal.map((item) => (
            <a
              href={item.href}
              target={item.external ? "_blank" : undefined}
              rel={item.external ? "noopener noreferrer" : undefined}
              class={styles.link()}
            >
              {item.label}
            </a>
          ))}
        </nav>
      )}
    </div>
  </div>
</footer>
