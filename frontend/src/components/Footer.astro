---
import { getFooterNav } from "@/lib/navigation";
import { getSiteSettings } from "@/lib/strapi";
import { site } from "@/config/site";
import { footerWrapper } from "@/components/layout";
import { Separator } from "@/components/starwind/separator";

const footer = await getFooterNav();
const { footerWidth, footerTone } = await getSiteSettings();
const styles = footerWrapper({ width: footerWidth, tone: footerTone });
---

<footer class="mt-auto" data-footer-width={footerWidth} data-footer-tone={footerTone}>
  <div class={styles.root()}>
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      {footer.columns.map((col) => (
        <div>
          <h3 class={styles.title()}>{col.title}</h3>
          <ul class="space-y-2">
            {col.items.map((item) => (
              <li>
                <a
                  href={item.href}
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noopener noreferrer" : undefined}
                  class={styles.link()}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <Separator class={styles.separator()} />
    <p class={styles.legal()}>{site.footer.legal}</p>
  </div>
</footer>
