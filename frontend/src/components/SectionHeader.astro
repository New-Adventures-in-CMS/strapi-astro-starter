---
interface Props {
  eyebrow?: string | null;
  heading?: string | null;
  lead?: string | null;
  align?: "left" | "center";
  onDark?: boolean;
  gap?: "sm" | "md" | "lg" | "xl";
  class?: string;
}

const {
  eyebrow,
  heading,
  lead,
  align = "left",
  onDark = false,
  gap = "xl",
  class: className,
} = Astro.props;

const alignClass = align === "center" ? "text-center mx-auto max-w-3xl" : "text-left";
const eyebrowColor = onDark ? "text-[var(--section-dark-fg-subtle)]" : "text-muted-foreground";
const headingColor = onDark ? "text-[var(--section-dark-fg)]" : "text-foreground";
const leadColor = onDark ? "text-[var(--section-dark-fg-muted)]" : "text-muted-foreground";
const gapMap = {
  sm: "mb-[var(--content-rhythm-sm)]",
  md: "mb-[var(--content-rhythm-md)]",
  lg: "mb-[var(--content-rhythm-lg)]",
  xl: "mb-[var(--content-rhythm-xl)]",
} as const;
const gapClass = gapMap[gap];
---

{(eyebrow || heading || lead) && (
  <header class:list={[alignClass, gapClass, className]} data-reveal="stagger">
    {eyebrow && (
      <p
        class:list={[
          "text-xs uppercase tracking-[0.2em] mb-[var(--content-rhythm-sm)]",
          eyebrowColor,
        ]}
      >
        {eyebrow}
      </p>
    )}
    {heading && (
      <h2 class:list={["font-heading text-balance", headingColor]} data-mask-heading>
        {heading}
      </h2>
    )}
    {lead && (
      <p
        class:list={[
          "mt-[var(--content-rhythm-md)] text-lg md:text-xl leading-relaxed max-w-2xl",
          align === "center" ? "mx-auto" : "",
          leadColor,
        ]}
      >
        {lead}
      </p>
    )}
  </header>
)}
