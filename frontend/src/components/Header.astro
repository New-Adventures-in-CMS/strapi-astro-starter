---
import { getHeaderNav } from "@/lib/navigation";
import { site } from "@/config/site";
import {
  NavigationMenu,
  NavigationMenuList,
  NavigationMenuItem,
  NavigationMenuTrigger,
  NavigationMenuContent,
  NavigationMenuLink,
} from "@/components/starwind/navigation-menu";
import {
  Sheet,
  SheetTrigger,
  SheetContent,
  SheetHeader,
  SheetTitle,
} from "@/components/starwind/sheet";

const navItems = await getHeaderNav();
const path = Astro.url.pathname;
const isActive = (href: string | undefined): boolean =>
  href ? (href === "/" ? path === "/" : path.startsWith(href)) : false;
---

<header class="border-b border-gray-200">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4">
    <!-- Brand -->
    <a href="/" class="text-lg font-semibold">{site.name}</a>

    <!-- Desktop nav (md and up) -->
    <nav aria-label="Navigazione principale" class="hidden md:flex">
      <NavigationMenu size="sm">
        <NavigationMenuList>
          {navItems.map((item) =>
            item.children?.length ? (
              <NavigationMenuItem value={item.label}>
                <NavigationMenuTrigger>{item.label}</NavigationMenuTrigger>
                <NavigationMenuContent>
                  <ul class="w-fit min-w-[180px] py-1">
                    {item.children.map((child) => (
                      <li>
                        <NavigationMenuLink
                          href={child.href}
                          target={child.external ? "_blank" : undefined}
                          rel={child.external ? "noopener noreferrer" : undefined}
                          active={isActive(child.href)}
                          aria-current={isActive(child.href) ? "page" : undefined}
                        >
                          {child.label}
                        </NavigationMenuLink>
                      </li>
                    ))}
                  </ul>
                </NavigationMenuContent>
              </NavigationMenuItem>
            ) : (
              <NavigationMenuItem>
                <NavigationMenuLink
                  href={item.href}
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noopener noreferrer" : undefined}
                  active={isActive(item.href)}
                  aria-current={isActive(item.href) ? "page" : undefined}
                >
                  {item.label}
                </NavigationMenuLink>
              </NavigationMenuItem>
            )
          )}
        </NavigationMenuList>
      </NavigationMenu>
    </nav>

    <!-- Mobile hamburger trigger (Sheet drawer) -->
    <div class="md:hidden">
      <Sheet>
        <SheetTrigger
          aria-label="Apri menu di navigazione"
          class="rounded p-2 text-gray-600 hover:bg-gray-100"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"
            />
          </svg>
        </SheetTrigger>
        <SheetContent side="left">
          <SheetHeader>
            <SheetTitle class="sr-only">Navigazione</SheetTitle>
          </SheetHeader>
          <nav aria-label="Navigazione mobile" class="flex flex-col gap-2 pt-4">
            {navItems.map((item) =>
              item.children?.length ? (
                <details class="group">
                  <summary class="flex cursor-pointer items-center justify-between py-2 text-sm text-gray-600 [&::-webkit-details-marker]:hidden">
                    {item.label}
                    <svg
                      class="h-3 w-3 transition-transform group-open:rotate-180"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 9l-7 7-7-7"
                      />
                    </svg>
                  </summary>
                  <ul class="mt-1 pl-4">
                    {item.children.map((child) => (
                      <li>
                        <a
                          href={child.href}
                          target={child.external ? "_blank" : undefined}
                          rel={child.external ? "noopener noreferrer" : undefined}
                          aria-current={isActive(child.href) ? "page" : undefined}
                          class:list={[
                            "block py-1.5 text-sm",
                            isActive(child.href)
                              ? "font-semibold text-black"
                              : "text-gray-600 hover:text-black",
                          ]}
                        >{child.label}</a>
                      </li>
                    ))}
                  </ul>
                </details>
              ) : (
                <a
                  href={item.href}
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noopener noreferrer" : undefined}
                  aria-current={isActive(item.href) ? "page" : undefined}
                  class:list={[
                    "block py-2 text-sm",
                    isActive(item.href) ? "font-semibold text-black" : "text-gray-600",
                  ]}
                >{item.label}</a>
              )
            )}
          </nav>
        </SheetContent>
      </Sheet>
    </div>
  </div>
</header>
