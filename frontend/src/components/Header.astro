---
import { getHeaderNav } from "@/lib/navigation";
import { site } from "@/config/site";
import { Container } from "@/components/layout";
import Logo from "@/components/Logo.astro";
import {
  NavigationMenu,
  NavigationMenuList,
  NavigationMenuItem,
  NavigationMenuTrigger,
  NavigationMenuContent,
  NavigationMenuLink,
} from "@/components/starwind/navigation-menu";
import {
  Sheet,
  SheetTrigger,
  SheetContent,
  SheetHeader,
  SheetTitle,
} from "@/components/starwind/sheet";

interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;

const navItems = await getHeaderNav();
const path = Astro.url.pathname;
const isActive = (href: string | undefined): boolean =>
  href ? (href === "/" ? path === "/" : path.startsWith(href)) : false;
---

<header
  class:list={[
    "fixed inset-x-0 top-0 z-50 transition-transform duration-300",
    !overlay && "bg-background text-foreground border-b border-border",
  ]}
  data-overlay={overlay ? "true" : "false"}
  data-state={overlay ? "transparent" : undefined}
  data-hidden="false"
>
  <Container width="wide" class="flex items-center justify-between py-5">
    <!-- Brand -->
    <a href="/" class="flex items-center gap-2" aria-label={site.name}>
      <Logo class="h-6 w-6" />
      <span class="text-lg font-semibold">{site.name}</span>
    </a>

    <!-- Desktop nav (md and up) -->
    <nav aria-label="Navigazione principale" class="hidden md:flex">
      <NavigationMenu size="sm">
        <NavigationMenuList>
          {navItems.map((item) =>
            item.children?.length ? (
              <NavigationMenuItem value={item.label}>
                <NavigationMenuTrigger class="text-sm font-medium">{item.label}</NavigationMenuTrigger>
                <NavigationMenuContent>
                  <ul class="w-fit min-w-[180px] py-1">
                    {item.children.map((child) => (
                      <li>
                        <NavigationMenuLink
                          href={child.href}
                          target={child.external ? "_blank" : undefined}
                          rel={child.external ? "noopener noreferrer" : undefined}
                          active={isActive(child.href)}
                          aria-current={isActive(child.href) ? "page" : undefined}
                        >
                          {child.label}
                        </NavigationMenuLink>
                      </li>
                    ))}
                  </ul>
                </NavigationMenuContent>
              </NavigationMenuItem>
            ) : (
              <NavigationMenuItem>
                <NavigationMenuLink
                  href={item.href}
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noopener noreferrer" : undefined}
                  active={isActive(item.href)}
                  aria-current={isActive(item.href) ? "page" : undefined}
                  class="text-sm font-medium"
                >
                  {item.label}
                </NavigationMenuLink>
              </NavigationMenuItem>
            )
          )}
        </NavigationMenuList>
      </NavigationMenu>
    </nav>

    <!-- Mobile hamburger trigger (Sheet drawer) -->
    <div class="md:hidden">
      <Sheet>
        <SheetTrigger
          aria-label="Apri menu di navigazione"
          class:list={[
            "rounded p-2 transition-colors",
            !overlay && "text-muted-foreground hover:bg-muted hover:text-foreground",
          ]}
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"
            />
          </svg>
        </SheetTrigger>
        <SheetContent side="left" class="px-4 pt-4">
          <SheetHeader class="p-0">
            <SheetTitle class="sr-only">Navigazione</SheetTitle>
          </SheetHeader>
          <nav aria-label="Navigazione mobile" class="mt-8 flex flex-col">
            {navItems.map((item) =>
              item.children?.length ? (
                <details class="group">
                  <summary class="flex cursor-pointer items-center justify-between rounded-md px-3 py-2 text-sm text-muted-foreground hover:bg-muted hover:text-foreground [&::-webkit-details-marker]:hidden">
                    {item.label}
                    <svg
                      class="h-3 w-3 transition-transform group-open:rotate-180"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 9l-7 7-7-7"
                      />
                    </svg>
                  </summary>
                  <ul class="mt-1 pl-3">
                    {item.children.map((child) => (
                      <li>
                        <a
                          href={child.href}
                          target={child.external ? "_blank" : undefined}
                          rel={child.external ? "noopener noreferrer" : undefined}
                          aria-current={isActive(child.href) ? "page" : undefined}
                          class:list={[
                            "block rounded-md px-3 py-1.5 text-sm",
                            isActive(child.href)
                              ? "bg-muted text-foreground"
                              : "text-muted-foreground hover:bg-muted hover:text-foreground",
                          ]}
                        >{child.label}</a>
                      </li>
                    ))}
                  </ul>
                </details>
              ) : (
                <a
                  href={item.href}
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noopener noreferrer" : undefined}
                  aria-current={isActive(item.href) ? "page" : undefined}
                  class:list={[
                    "block rounded-md px-3 py-2 text-sm",
                    isActive(item.href)
                      ? "bg-muted text-foreground"
                      : "text-muted-foreground hover:bg-muted hover:text-foreground",
                  ]}
                >{item.label}</a>
              )
            )}
          </nav>
        </SheetContent>
      </Sheet>
    </div>
  </Container>

  {overlay && (
    <script>
      const sentinel = document.getElementById("header-overlay-sentinel");
      const header = document.querySelector("header[data-overlay='true']");
      if (sentinel && header) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              header.setAttribute("data-state", e.isIntersecting ? "transparent" : "solid");
            });
          },
          { root: null, threshold: 0 }
        );
        io.observe(sentinel);
      }
    </script>
  )}

  <!-- Auto-hide script: directional scroll detection with focus reveal -->
  <script>
    const el = document.querySelector<HTMLElement>("header[data-hidden]");
    if (el) {
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (prefersReducedMotion) {
        el.style.transition = "none";
      }

      let lastY = window.scrollY;
      let ticking = false;
      const THRESHOLD = 8;
      const TOP_THRESHOLD = 40;

      function update() {
        const y = window.scrollY;
        const delta = y - lastY;

        if (y <= TOP_THRESHOLD) {
          el!.setAttribute("data-hidden", "false");
        } else if (Math.abs(delta) >= THRESHOLD) {
          if (delta > 0) {
            el!.setAttribute("data-hidden", "true");
          } else {
            el!.setAttribute("data-hidden", "false");
          }
          lastY = y;
        }
        ticking = false;
      }

      window.addEventListener("scroll", () => {
        if (!ticking) {
          window.requestAnimationFrame(update);
          ticking = true;
        }
      }, { passive: true });

      // Focus reveal
      el.addEventListener("focusin", () => {
        el.setAttribute("data-hidden", "false");
      });
    }
  </script>
</header>
