---
// frontend/src/pages/404.astro
import Layout from "@/layouts/Layout.astro";
import { Section, Container } from "@/components/layout";
import { Button } from "@/components/starwind/button";
---
<Layout title="Pagina non trovata" noindex={true}>
  <Section spacing="default">
    <Container width="default">
      <div class="text-center max-w-xl mx-auto">
        <p class="text-[var(--fs-display)] font-heading uppercase tracking-tight text-primary">404</p>
        <h1 class="mt-6 text-foreground">Pagina non trovata</h1>
        <p class="mt-3 text-muted-foreground">
          La pagina che cerchi non esiste o è stata spostata.
        </p>
        <div class="mt-8">
          <Button href="/" variant="default">Torna alla home</Button>
        </div>
      </div>
    </Container>
  </Section>
</Layout>
