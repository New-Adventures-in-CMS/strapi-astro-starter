---
// frontend/src/pages/404.astro
import Layout from "@/layouts/Layout.astro";
---
<Layout title="Pagina non trovata" noindex={true}>
  <section class="mx-auto max-w-xl py-20 text-center">
    <p class="text-7xl font-bold tracking-tight text-brand-500">404</p>
    <h1 class="mt-6 text-2xl font-semibold text-gray-900">Pagina non trovata</h1>
    <p class="mt-3 text-gray-600">
      La pagina che cerchi non esiste o è stata spostata.
    </p>
    <a href="/" class="mt-8 inline-block rounded-md bg-brand-500 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700">
      Torna alla home
    </a>
  </section>
</Layout>
