---
// frontend/src/pages/[slug].astro
// Catch-all for CMS pages. Static routes (index, esempio, 404, dev/*) take
// priority — CMS page slugs must not collide with them.
import Layout from "@/layouts/Layout.astro";
import { Section, Container } from "@/components/layout";
import { Prose } from "@/components/starwind/prose";
import BlockRenderer from "@/components/blocks/BlockRenderer.astro";
import { strapiFind, pageBlocksPopulate } from "@/lib/strapi";
import { renderMarkdown } from "@/lib/markdown";
import type { Page } from "@/types";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/404");

if (slug === "home") return Astro.redirect("/");

const isPreview = Astro.cookies.get("__strapi_preview")?.value === "true";
let page: Page | null = null;

try {
  const res = await strapiFind<Page>(
    "pages",
    {
      filters: { slug: { $eq: slug } },
      populate: pageBlocksPopulate,
    },
    { preview: isPreview },
  );
  page = res.data[0] ?? null;
} catch {
  // CMS unreachable — treat as not found
}

if (!page) return Astro.redirect("/404");

const bodyHtml = renderMarkdown(page.body);
const hasBlocks = page.blocks && page.blocks.length > 0;
const firstBlock = page.blocks?.[0];
const headerOverlay =
  (firstBlock?.__component === "blocks.hero-static" ||
    firstBlock?.__component === "blocks.hero-slider") &&
  firstBlock.immersive === true;
---

<Layout title={page.title} description={page.seo_desc ?? undefined} headerOverlay={headerOverlay}>
  {hasBlocks && <BlockRenderer blocks={page.blocks!} />}
  {!hasBlocks && (
    <Section spacing="lg">
      <Container width="prose">
        <article>
          <h1>{page.title}</h1>
          {bodyHtml && <Prose class="mt-[var(--content-rhythm-md)]" set:html={bodyHtml} />}
        </article>
      </Container>
    </Section>
  )}
  {hasBlocks && bodyHtml && (
    <Section spacing="lg">
      <Container width="prose">
        <article>
          <Prose set:html={bodyHtml} />
        </article>
      </Container>
    </Section>
  )}
  {isPreview && (
    <div class="fixed bottom-0 left-0 right-0 z-50 bg-amber-500 py-2 text-center text-sm font-medium text-amber-950">
      Anteprima bozza —{" "}
      <a
        href={`/api/exit-preview?url=${encodeURIComponent(Astro.url.pathname)}`}
        class="underline hover:no-underline"
      >
        Esci dall'anteprima
      </a>
    </div>
  )}
</Layout>
