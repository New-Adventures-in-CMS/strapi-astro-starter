---
import BlockGallery from "@/components/blocks/BlockGallery.astro";
import "@/styles/starwind.css";
import type { StrapiMedia } from "@/types";

const origin = Astro.url.origin;

const mockImages: StrapiMedia[] = [
  {
    id: 1,
    url: `${origin}/_test/pixel.png`,
    name: "pixel.png",
    alternativeText: "Sample raster 1",
    caption: "First image with a caption",
    width: 800,
    height: 600,
    mime: "image/png",
    ext: ".png",
    size: 10,
  },
  {
    id: 2,
    url: `${origin}/_test/pixel.png`,
    name: "pixel2.png",
    alternativeText: "Sample raster 2",
    width: 800,
    height: 600,
    mime: "image/png",
    ext: ".png",
    size: 10,
  },
  {
    id: 3,
    url: "/_test/gallery/3.svg",
    name: "3.svg",
    alternativeText: "Sample image 3",
    caption: "Third image — also captioned",
    width: 800,
    height: 600,
    mime: "image/svg+xml",
    ext: ".svg",
    size: 1,
  },
  {
    id: 4,
    url: "/_test/gallery/4.svg",
    name: "4.svg",
    alternativeText: "Sample image 4",
    width: 800,
    height: 600,
    mime: "image/svg+xml",
    ext: ".svg",
    size: 1,
  },
  {
    id: 5,
    url: `${origin}/_test/pixel.png`,
    name: "pixel3.png",
    alternativeText: "Sample raster 5",
    caption: "Fifth image caption for testing",
    width: 800,
    height: 600,
    mime: "image/png",
    ext: ".png",
    size: 10,
  },
  {
    id: 6,
    url: "/_test/gallery/6.svg",
    name: "6.svg",
    alternativeText: "Sample image 6",
    width: 800,
    height: 600,
    mime: "image/svg+xml",
    ext: ".svg",
    size: 1,
  },
];
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Gallery Dev Fixture</title>
  </head>
  <body class="bg-background text-foreground" data-mask-images>
    <main class="py-8">
      <BlockGallery
        eyebrow="SHOWCASE"
        heading="Gallery block fixture"
        lead="Mock data — images 1, 2, 5 are raster (blur-up); 3, 4, 6 are SVG (plain). Captions on 1, 3, 5."
        tone="light"
        images={mockImages}
      />
    </main>
    <script>
      import { initReveal } from "@skeleton/reveal.js";
      import { initMaskReveal } from "@skeleton/mask-reveal.js";
      import { initImageLoading } from "@skeleton/image-loading.js";
      initReveal();
      initMaskReveal();
      initImageLoading();
    </script>
  </body>
</html>
