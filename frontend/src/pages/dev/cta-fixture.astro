---
// frontend/src/pages/dev/cta-fixture.astro
// Dev fixture for e2e tests of shared.link CTA surfaces:
// hero dual CTA + alignment, card button/full_card modes, link resolution.
import BlockHeroStatic from "@/components/blocks/BlockHeroStatic.astro";
import BlockCardGrid from "@/components/blocks/BlockCardGrid.astro";
import type { SharedLink, SharedCard } from "@/types";
import "@/styles/starwind.css";

const internalCta: SharedLink = {
  label: "Internal link",
  linkMode: "internal",
  page: { slug: "about" },
};

const externalCta: SharedLink = {
  label: "External link",
  linkMode: "external",
  externalUrl: "https://example.com",
  target: "blank",
};

const buttonCards: SharedCard[] = [
  {
    title: "Button card",
    description: "Card with button CTA mode.",
    image: null,
    cta_primary: internalCta,
  },
];

const fullCards: SharedCard[] = [
  {
    title: "Full card",
    description: "Card with full_card stretched link overlay.",
    image: null,
    cta_primary: externalCta,
  },
];
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CTA Fixture</title>
  </head>
  <body>
    <div data-section="hero-left">
      <BlockHeroStatic
        heading="Hero left align"
        eyebrow="E2E"
        subheading="CTA alignment test — left"
        cta_primary={internalCta}
        cta_secondary={externalCta}
        align="bottom-left"
      />
    </div>
    <div data-section="hero-center">
      <BlockHeroStatic
        heading="Hero center align"
        eyebrow="E2E"
        subheading="CTA alignment test — center"
        cta_primary={internalCta}
        cta_secondary={externalCta}
        align="center"
      />
    </div>
    <div data-section="card-button">
      <BlockCardGrid heading="Button cards" cards={buttonCards} cta_style="button" />
    </div>
    <div data-section="card-full">
      <BlockCardGrid heading="Full cards" cards={fullCards} cta_style="full_card" />
    </div>
  </body>
</html>
