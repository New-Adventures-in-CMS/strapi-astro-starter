---
// frontend/src/pages/dev/hero-slider.astro
// Dev fixture — tests BlockHeroSlider as carousel consumer + single-slide degradation.
import BlockHeroSlider from "@/components/blocks/BlockHeroSlider.astro";
import BlockHeroStatic from "@/components/blocks/BlockHeroStatic.astro";
import "@/styles/starwind.css";

const THREE_SLIDES = [
  {
    eyebrow: "SLIDE ONE",
    heading: "Ship editorial content, fast.",
    subheading: "A production-ready foundation for content-driven sites.",
    image: null,
  },
  {
    eyebrow: "SLIDE TWO",
    heading: "Compose pages without code.",
    subheading: "Hero, rich text, image + text, card grids.",
    image: null,
  },
  {
    eyebrow: "SLIDE THREE",
    heading: "Taste included, not bolted on.",
    subheading: "Semantic tokens, fluid type scale, dark bands.",
    image: null,
  },
];
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hero Slider Dev Fixture</title>
  </head>
  <body>
    <!-- Multi-slide carousel (3000ms autoplay for faster tests) -->
    <BlockHeroSlider slides={THREE_SLIDES} autoplayDelay={3000} heroStyle="drift" />

    <!-- Single-slide static degradation -->
    <div data-hero-single>
      <BlockHeroStatic heading="Static single slide." eyebrow="SINGLE" />
    </div>
  </body>
</html>
