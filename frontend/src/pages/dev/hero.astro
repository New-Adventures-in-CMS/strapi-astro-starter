---
// frontend/src/pages/dev/hero.astro
// Dev fixture — not linked in nav. Tests BlockHero transition strategies.
// Three labeled sections (drift / fade / slide) + single-slide static.
import BlockHero from "@/components/blocks/BlockHero.astro";
import type { StrapiMedia } from "@/types";
import "@/styles/starwind.css";

const svgMedia = (svg: string, alt: string): StrapiMedia => ({
  id: 0,
  url: `data:image/svg+xml,${encodeURIComponent(svg)}`,
  name: "dev-fixture",
  mime: "image/svg+xml",
  size: 0,
  alternativeText: alt,
});

const SVG1 = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1600 900'>
  <defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'>
    <stop offset='0' stop-color='#6d28d9'/><stop offset='.5' stop-color='#db2777'/>
    <stop offset='1' stop-color='#f59e0b'/></linearGradient></defs>
  <rect width='1600' height='900' fill='url(#g)'/>
  <g fill='none' stroke='#fff' stroke-opacity='.18' stroke-width='3'>
    <circle cx='420' cy='300' r='130'/><circle cx='1180' cy='640' r='210'/>
    <path d='M0 220 L1600 420'/><path d='M0 520 L1600 760'/></g></svg>`;

const SVG2 = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1600 900'>
  <defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'>
    <stop offset='0' stop-color='#0d9488'/><stop offset='.5' stop-color='#0284c7'/>
    <stop offset='1' stop-color='#1e3a8a'/></linearGradient></defs>
  <rect width='1600' height='900' fill='url(#g)'/>
  <g fill='none' stroke='#fff' stroke-opacity='.18' stroke-width='3'>
    <rect x='200' y='180' width='320' height='320'/>
    <rect x='980' y='420' width='420' height='260'/>
    <path d='M0 700 L1600 300'/><path d='M0 120 L1600 500'/></g></svg>`;

const SVG3 = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1600 900'>
  <defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'>
    <stop offset='0' stop-color='#ea580c'/><stop offset='.5' stop-color='#dc2626'/>
    <stop offset='1' stop-color='#7f1d1d'/></linearGradient></defs>
  <rect width='1600' height='900' fill='url(#g)'/>
  <g fill='none' stroke='#fff' stroke-opacity='.18' stroke-width='3'>
    <polygon points='300,700 560,240 820,700'/>
    <polygon points='900,720 1200,320 1500,720'/>
    <path d='M0 460 L1600 460'/></g></svg>`;

const THREE_SLIDES = [
  {
    eyebrow: "SLIDE ONE",
    heading: "Ship editorial content, fast.",
    subheading: "A production-ready foundation for content-driven sites.",
    cta_text: "Explore",
    cta_url: "#",
    image: svgMedia(SVG1, "Test slide 1"),
  },
  {
    eyebrow: "SLIDE TWO",
    heading: "Compose pages without code.",
    subheading: "Hero, rich text, image + text, card grids.",
    cta_text: "See blocks",
    cta_url: "#",
    image: svgMedia(SVG2, "Test slide 2"),
  },
  {
    eyebrow: "SLIDE THREE",
    heading: "Taste included, not bolted on.",
    subheading: "Semantic tokens, fluid type scale, dark bands.",
    cta_text: "Read guide",
    cta_url: "#",
    image: svgMedia(SVG3, "Test slide 3"),
  },
];

const ONE_SLIDE = [
  {
    eyebrow: "SINGLE",
    heading: "Static single slide.",
    subheading: "No carousel controls should appear.",
    cta_text: null,
    cta_url: null,
    image: null,
  },
];
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hero Transition Strategy Fixture</title>
  </head>
  <body>
    <!-- Drift strategy (3 slides, 3000ms autoplay) -->
    <div data-hero-section="drift">
      <div class="test-label"><strong>DRIFT</strong> Lo sfondo deriva lateralmente, più lento del testo. ✓ se il fondo "resta indietro" rispetto al titolo durante la transizione.</div>
      <BlockHero
        heading="Ship editorial content, fast."
        slides={THREE_SLIDES}
        autoplayDelay={3000}
        transition="slide"
        effect="drift"
      />
    </div>

    <!-- Parallax (depth, pointer-driven) strategy (3 slides, 3000ms autoplay, fade) -->
    <div data-hero-section="parallax">
      <div class="test-label"><strong>PARALLAX</strong> Profondità sfondo/testo guidata dal puntatore (transizione fade). ✓ muovendo il mouse lo sfondo deriva più del testo; su touch è statico.</div>
      <BlockHero
        heading="Ship editorial content, fast."
        slides={THREE_SLIDES}
        autoplayDelay={3000}
        transition="fade"
        effect="parallax"
      />
    </div>

    <!-- Focus (scale) strategy (3 slides, 3000ms autoplay) -->
    <div data-hero-section="focus">
      <div class="test-label"><strong>FOCUS</strong> La slide attiva è ingrandita (~8%) e si rimpicciolisce uscendo. ✓ se l'immagine attiva "respira".</div>
      <BlockHero
        heading="Ship editorial content, fast."
        slides={THREE_SLIDES}
        autoplayDelay={3000}
        transition="slide"
        effect="focus"
      />
    </div>

    <!-- Dim (brightness neighbors) strategy (3 slides, 3000ms autoplay) -->
    <div data-hero-section="dim">
      <div class="test-label"><strong>DIM</strong> La slide che esce si scurisce; l'attiva resta a piena luce. ✓ se c'è uno stacco netto di luminosità in transizione.</div>
      <BlockHero
        heading="Ship editorial content, fast."
        slides={THREE_SLIDES}
        autoplayDelay={3000}
        transition="slide"
        effect="dim"
      />
    </div>

    <!-- Fade strategy (3 slides, 3000ms autoplay) -->
    <div data-hero-section="fade">
      <div class="test-label"><strong>FADE</strong> Dissolvenza incrociata: cambia solo l'opacità, nessun movimento/scala/luce. ✓ se non c'è slittamento né zoom.</div>
      <BlockHero
        heading="Ship editorial content, fast."
        slides={THREE_SLIDES}
        autoplayDelay={3000}
        transition="fade"
      />
    </div>

    <!-- Slide strategy (3 slides, 3000ms autoplay) -->
    <div data-hero-section="slide">
      <div class="test-label"><strong>SLIDE</strong> Scorrimento orizzontale netto, nessun effetto sul media. ✓ se è un semplice slittamento.</div>
      <BlockHero
        heading="Ship editorial content, fast."
        slides={THREE_SLIDES}
        autoplayDelay={3000}
        transition="slide"
      />
    </div>

    <!-- Single-slide static degradation -->
    <div data-hero-single>
      <div class="test-label"><strong>SINGLE</strong> Slide singola: nessun controllo carousel (frecce/dot) e nessun effetto. ✓ se non compaiono controlli.</div>
      <BlockHero
        heading="Static single slide."
        slides={ONE_SLIDE}
      />
    </div>
    <style>
      [data-hero-section], [data-hero-single] { position: relative; }
      .test-label {
        position: absolute; top: 0; left: 0; right: 0; z-index: 50;
        pointer-events: none;
        background: rgba(0, 0, 0, 0.72); color: #fff;
        font: 500 12px/1.5 ui-monospace, "SF Mono", Menlo, monospace;
        letter-spacing: 0.02em; padding: 8px 14px;
      }
      .test-label strong { letter-spacing: 0.12em; margin-right: 10px; }
    </style>
  </body>
</html>
