---
// frontend/src/pages/dev/hero.astro
// Dev fixture — tests BlockHeroSlider heroStyle presets + BlockHeroStatic effects.
import BlockHeroSlider from "@/components/blocks/BlockHeroSlider.astro";
import BlockHeroStatic from "@/components/blocks/BlockHeroStatic.astro";
import type { StrapiMedia } from "@/types";
import "@/styles/starwind.css";

const svgMedia = (svg: string, alt: string): StrapiMedia => ({
  id: 0,
  url: `data:image/svg+xml,${encodeURIComponent(svg)}`,
  name: "dev-fixture",
  mime: "image/svg+xml",
  size: 0,
  alternativeText: alt,
});

const SVG1 = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1600 900'>
  <defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'>
    <stop offset='0' stop-color='#6d28d9'/><stop offset='.5' stop-color='#db2777'/>
    <stop offset='1' stop-color='#f59e0b'/></linearGradient></defs>
  <rect width='1600' height='900' fill='url(#g)'/>
  <g fill='none' stroke='#fff' stroke-opacity='.18' stroke-width='3'>
    <circle cx='420' cy='300' r='130'/><circle cx='1180' cy='640' r='210'/>
    <path d='M0 220 L1600 420'/><path d='M0 520 L1600 760'/></g></svg>`;

const SVG2 = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1600 900'>
  <defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'>
    <stop offset='0' stop-color='#0d9488'/><stop offset='.5' stop-color='#0284c7'/>
    <stop offset='1' stop-color='#1e3a8a'/></linearGradient></defs>
  <rect width='1600' height='900' fill='url(#g)'/>
  <g fill='none' stroke='#fff' stroke-opacity='.18' stroke-width='3'>
    <rect x='200' y='180' width='320' height='320'/>
    <rect x='980' y='420' width='420' height='260'/>
    <path d='M0 700 L1600 300'/><path d='M0 120 L1600 500'/></g></svg>`;

const SVG3 = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1600 900'>
  <defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'>
    <stop offset='0' stop-color='#ea580c'/><stop offset='.5' stop-color='#dc2626'/>
    <stop offset='1' stop-color='#7f1d1d'/></linearGradient></defs>
  <rect width='1600' height='900' fill='url(#g)'/>
  <g fill='none' stroke='#fff' stroke-opacity='.18' stroke-width='3'>
    <polygon points='300,700 560,240 820,700'/>
    <polygon points='900,720 1200,320 1500,720'/>
    <path d='M0 460 L1600 460'/></g></svg>`;

const THREE_SLIDES = [
  {
    eyebrow: "SLIDE ONE",
    heading: "Ship editorial content, fast.",
    subheading: "A production-ready foundation for content-driven sites.",
    image: svgMedia(SVG1, "Test slide 1"),
  },
  {
    eyebrow: "SLIDE TWO",
    heading: "Compose pages without code.",
    subheading: "Hero, rich text, image + text, card grids.",
    image: svgMedia(SVG2, "Test slide 2"),
  },
  {
    eyebrow: "SLIDE THREE",
    heading: "Taste included, not bolted on.",
    subheading: "Semantic tokens, fluid type scale, dark bands.",
    image: svgMedia(SVG3, "Test slide 3"),
  },
];
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hero Transition Strategy Fixture</title>
  </head>
  <body>
    <div data-hero-section="drift">
      <div class="test-label">
        <strong>DRIFT</strong> Lo sfondo deriva lateralmente, più lento del testo.
      </div>
      <BlockHeroSlider slides={THREE_SLIDES} autoplayDelay={3000} heroStyle="drift" />
    </div>

    <div data-hero-section="parallax">
      <div class="test-label">
        <strong>PARALLAX</strong> (align=<code>bottom-left</code>) Entrata scaglionata a bandiera.
      </div>
      <BlockHeroSlider
        slides={THREE_SLIDES}
        autoplayDelay={3000}
        heroStyle="parallax"
        align="bottom-left"
      />
    </div>

    <div data-hero-section="tilt">
      <div class="test-label">
        <strong>TILT</strong> Profondità al puntatore: muovi il mouse.
      </div>
      <BlockHeroSlider slides={THREE_SLIDES} autoplayDelay={3000} heroStyle="tilt" />
    </div>

    <div data-hero-section="focus">
      <div class="test-label">
        <strong>FOCUS</strong> La slide attiva è ingrandita (~8%) e si rimpicciolisce uscendo.
      </div>
      <BlockHeroSlider slides={THREE_SLIDES} autoplayDelay={3000} heroStyle="focus" />
    </div>

    <div data-hero-section="dim">
      <div class="test-label">
        <strong>DIM</strong> La slide che esce si scurisce; l'attiva resta a piena luce.
      </div>
      <BlockHeroSlider slides={THREE_SLIDES} autoplayDelay={3000} heroStyle="dim" />
    </div>

    <div data-hero-section="fade">
      <div class="test-label">
        <strong>FADE</strong> Dissolvenza incrociata, nessun movimento/scala/luce.
      </div>
      <BlockHeroSlider slides={THREE_SLIDES} autoplayDelay={3000} heroStyle="fade" />
    </div>

    <div data-hero-section="slide">
      <div class="test-label">
        <strong>SLIDE</strong> Scorrimento orizzontale netto, nessun effetto sul media.
      </div>
      <BlockHeroSlider slides={THREE_SLIDES} autoplayDelay={3000} heroStyle="slide" />
    </div>

    <div data-hero-section="ken-burns">
      <div class="test-label">
        <strong>KEN-BURNS</strong> Zoom + pan lento e continuo sulla slide attiva.
      </div>
      <BlockHeroSlider slides={THREE_SLIDES} autoplayDelay={3000} heroStyle="ken-burns" />
    </div>

    <div data-hero-section="preset-default">
      <div class="test-label">
        <strong>PRESET · default</strong> Nessun heroStyle → default da config.
      </div>
      <BlockHeroSlider slides={THREE_SLIDES} autoplayDelay={3000} />
    </div>

    <div data-hero-section="preset-parallax">
      <div class="test-label">
        <strong>PRESET · parallax</strong> heroStyle="parallax" con align bottom-left.
      </div>
      <BlockHeroSlider
        slides={THREE_SLIDES}
        autoplayDelay={3000}
        heroStyle="parallax"
        align="bottom-left"
      />
    </div>

    <div data-hero-section="tilt-single">
      <div class="test-label">
        <strong>TILT · STATIC</strong> Tilt su hero statico (nessun carosello). ✓ muovi il mouse.
      </div>
      <BlockHeroStatic
        heading="Depth on a single slide."
        eyebrow="TILT · SINGLE"
        subheading="Pointer-driven — nessun carosello."
        image={svgMedia(SVG1, "Tilt single demo")}
        effect="tilt"
      />
    </div>

    <div data-hero-section="ken-burns-single">
      <div class="test-label">
        <strong>KEN-BURNS · STATIC</strong> Ken-burns su hero statico (nessun carosello). ✓ zoom+pan
        lento.
      </div>
      <BlockHeroStatic
        heading="Ken-burns without carousel."
        eyebrow="KEN-BURNS · SINGLE"
        subheading="CSS animation — nessun CarouselAPI."
        image={svgMedia(SVG2, "Ken-burns single demo")}
        effect="ken-burns"
      />
    </div>

    <div data-hero-single>
      <div class="test-label">
        <strong>STATIC</strong> Hero statico senza effetti. ✓ nessun controllo carousel.
      </div>
      <BlockHeroStatic heading="Static single slide." eyebrow="SINGLE" />
    </div>
    <style>
      [data-hero-section],
      [data-hero-single] {
        position: relative;
      }
      .test-label {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        z-index: 50;
        pointer-events: none;
        background: rgba(0, 0, 0, 0.72);
        color: #fff;
        font:
          500 12px/1.5 ui-monospace,
          "SF Mono",
          Menlo,
          monospace;
        letter-spacing: 0.02em;
        padding: 8px 14px;
      }
      .test-label strong {
        letter-spacing: 0.12em;
        margin-right: 10px;
      }
    </style>
  </body>
</html>
