---
import "@/styles/starwind.css";
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Scrollspy Fixture</title>
    <style>
      body {
        margin: 0;
        font-family: system-ui, sans-serif;
      }
      .anchor-nav {
        position: fixed;
        top: 1rem;
        right: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        z-index: 10;
        background: var(--surface-1, #fff);
        padding: 1rem;
        border-radius: 0.5rem;
        box-shadow: 0 2px 8px rgb(0 0 0 / 0.1);
      }
      .anchor-nav a {
        text-decoration: none;
        color: var(--text-2, #666);
        padding: 0.25rem 0.5rem;
        border-radius: 0.25rem;
        transition: background 150ms;
      }
      .anchor-nav a[data-active] {
        background: var(--primary, #2563eb);
        color: #fff;
      }
      .section {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        padding: 2rem;
      }
      .section:nth-child(odd) {
        background: var(--surface-2, #f5f5f5);
      }
    </style>
  </head>
  <body>
    <nav class="anchor-nav" data-scrollspy-nav>
      <a href="#intro" data-nav-link="intro">
        Intro
      </a>
      <a href="#features" data-nav-link="features">
        Features
      </a>
      <a href="#pricing" data-nav-link="pricing">
        Pricing
      </a>
      <a href="#contact" data-nav-link="contact">
        Contact
      </a>
    </nav>

    <section id="intro" class="section" data-spy-section>
      Intro
    </section>
    <section id="features" class="section" data-spy-section>
      Features
    </section>
    <section id="pricing" class="section" data-spy-section>
      Pricing
    </section>
    <section id="contact" class="section" data-spy-section>
      Contact
    </section>

    <script>
      import { createScrollSpy } from "@skeleton/scrollspy.js";

      const sections = [...document.querySelectorAll("[data-spy-section]")];
      const nav = document.querySelector("[data-scrollspy-nav]")!;

      createScrollSpy({
        sections,
        onChange(active) {
          nav.querySelectorAll("[data-nav-link]").forEach((a) => {
            if (active && a.getAttribute("data-nav-link") === active.id) {
              a.setAttribute("data-active", "");
            } else {
              a.removeAttribute("data-active");
            }
          });
        },
      });
    </script>
  </body>
</html>
