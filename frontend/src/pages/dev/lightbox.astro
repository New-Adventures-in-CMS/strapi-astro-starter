---
import DialogPrimitive from "@starwind-ui/astro/dialog";
import {
  dialogBackdrop,
  dialogContent,
  dialogCloseButton,
} from "@/components/starwind/dialog/variants";
import "@/styles/starwind.css";

const images = [1, 2, 3, 4, 5, 6].map((n) => ({
  src: `/_test/gallery/${n}.svg`,
  alt: `Sample image ${n}`,
}));
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Lightbox Dev Fixture</title>
  </head>
  <body class="bg-background p-8">
    <h1 class="mb-6 text-2xl font-bold text-foreground">Lightbox Skeleton Collaudo</h1>

    <div data-lightbox>
      <!-- Thumbnail grid -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4" data-testid="thumb-grid">
        {images.map((img, i) => (
          <button
            type="button"
            data-lightbox-thumb
            data-index={i}
            data-testid={`thumb-${i}`}
            class="cursor-pointer overflow-hidden rounded-lg border border-border focus-visible:ring-outline/50 focus-visible:ring-3 outline-none transition-shadow"
          >
            <img
              src={img.src}
              alt={img.alt}
              width="400"
              height="267"
              loading="lazy"
              class="aspect-[3/2] w-full object-cover"
            />
          </button>
        ))}
      </div>

      <!-- Dialog (lightbox overlay) -->
      <DialogPrimitive.Root
        closeOnEscape={true}
        closeOnOutsideInteract={false}
        modal={true}
        data-slot="dialog"
      >
        <DialogPrimitive.Backdrop
          class={dialogBackdrop()}
          data-state="closed"
          hidden
          data-slot="dialog-backdrop"
        />

        <DialogPrimitive.Popup
          class={dialogContent({ surface: "lightbox" })}
          data-state="closed"
          aria-label="Galleria immagini"
          data-slot="dialog-content"
          data-testid="lightbox-dialog"
        >
          <!-- Carousel inside dialog -->
          <div
            data-lightbox-carousel
            tabindex="0"
            class="flex h-full w-full flex-col items-center justify-center outline-none"
          >
            <div class="relative flex w-full flex-1 items-center" data-carousel-viewport>
              <div class="flex h-full w-full">
                {images.map((img, i) => (
                  <div class="min-w-0 shrink-0 grow-0 basis-full">
                    <img
                      src={img.src}
                      alt={img.alt}
                      loading="lazy"
                      class="mx-auto h-full w-full object-contain"
                      data-testid={`slide-img-${i}`}
                    />
                  </div>
                ))}
              </div>
            </div>

            <!-- Nav buttons -->
            <button
              type="button"
              data-carousel-prev
              class="absolute left-4 top-1/2 -translate-y-1/2 rounded-full bg-background/20 p-3 text-background shadow transition hover:bg-background/40 disabled:opacity-30"
              aria-label="Precedente"
              data-testid="lightbox-prev"
            >
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 19l-7-7 7-7"
                />
              </svg>
            </button>
            <button
              type="button"
              data-carousel-next
              class="absolute right-14 top-1/2 -translate-y-1/2 rounded-full bg-background/20 p-3 text-background shadow transition hover:bg-background/40 disabled:opacity-30"
              aria-label="Successivo"
              data-testid="lightbox-next"
            >
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"
                />
              </svg>
            </button>
          </div>

          <!-- Close button -->
          <button
            type="button"
            data-sw-dialog-close
            class={dialogCloseButton({ surface: "lightbox" })}
            aria-label="Chiudi"
            data-slot="dialog-close"
            data-testid="lightbox-close"
          >
            <svg
              class="size-6 transition-opacity"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"
              />
            </svg>
            <span class="sr-only">Chiudi</span>
          </button>
        </DialogPrimitive.Popup>
      </DialogPrimitive.Root>
    </div>

    <script>
      import { createLightbox } from "@skeleton/lightbox.js";
      document.querySelectorAll<HTMLElement>("[data-lightbox]").forEach((root) => {
        createLightbox(root);
      });
    </script>
  </body>
</html>
