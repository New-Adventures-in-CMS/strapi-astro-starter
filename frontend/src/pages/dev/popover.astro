---
import {
  Popover,
  PopoverContent,
  PopoverDescription,
  PopoverHeader,
  PopoverTitle,
  PopoverTrigger,
} from "@/components/starwind/popover";
import "@/styles/starwind.css";
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Popover Dev Fixture</title>
  </head>
  <body class="bg-background p-8">
    <h1 class="mb-6 text-2xl font-bold">Popover Skeleton Collaudo</h1>

    <div class="flex min-h-[50vh] items-center justify-center">
      <Popover>
        <PopoverTrigger data-testid="popover-trigger">Apri popover</PopoverTrigger>

        <PopoverContent data-testid="popover-content">
          <PopoverHeader>
            <PopoverTitle>Impostazioni rapide</PopoverTitle>
            <PopoverDescription>Pannello di configurazione veloce.</PopoverDescription>
          </PopoverHeader>

          <div class="flex flex-col gap-2 pt-2">
            <label class="flex items-center gap-2 text-sm">
              <input type="checkbox" checked />
              Notifiche attive
            </label>
            <label class="flex items-center gap-2 text-sm">
              <input type="checkbox" />
              Modalità scura
            </label>
          </div>
        </PopoverContent>
      </Popover>
    </div>
  </body>
</html>
