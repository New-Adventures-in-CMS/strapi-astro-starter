---
// frontend/src/pages/pagine/[slug].astro
import Layout from "@/layouts/Layout.astro";
import { Prose } from "@/components/starwind/prose";
import { strapiFind } from "@/lib/strapi";
import { renderMarkdown } from "@/lib/markdown";
import type { Page } from "@/types";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/404");

let page: Page | null = null;

try {
  const res = await strapiFind<Page>("pages", {
    filters: { slug: { $eq: slug } },
  });
  page = res.data[0] ?? null;
} catch {
  // CMS unreachable — treat as not found
}

if (!page) return Astro.redirect("/404");

const bodyHtml = renderMarkdown(page.body);
---
<Layout title={page.title} description={page.seo_desc ?? undefined}>
  <article class="mx-auto max-w-3xl py-12">
    <h1 class="text-4xl font-bold tracking-tight">{page.title}</h1>
    {bodyHtml && <Prose class="mt-6" set:html={bodyHtml} />}
  </article>
</Layout>
