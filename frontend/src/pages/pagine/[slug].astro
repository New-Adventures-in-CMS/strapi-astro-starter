---
// frontend/src/pages/pagine/[slug].astro
import Layout from "@/layouts/Layout.astro";
import { Section, Container } from "@/components/layout";
import { Prose } from "@/components/starwind/prose";
import BlockRenderer from "@/components/blocks/BlockRenderer.astro";
import { strapiFind, pageBlocksPopulate } from "@/lib/strapi";
import { renderMarkdown } from "@/lib/markdown";
import type { Page } from "@/types";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/404");

let page: Page | null = null;

try {
  const res = await strapiFind<Page>("pages", {
    filters: { slug: { $eq: slug } },
    populate: pageBlocksPopulate,
  });
  page = res.data[0] ?? null;
} catch {
  // CMS unreachable — treat as not found
}

if (!page) return Astro.redirect("/404");

const bodyHtml = renderMarkdown(page.body);
const hasBlocks = page.blocks && page.blocks.length > 0;
const firstBlock = page.blocks?.[0];
const headerOverlay = firstBlock?.__component === "blocks.hero" && firstBlock.immersive === true;
---
<Layout title={page.title} description={page.seo_desc ?? undefined} headerOverlay={headerOverlay}>
  {hasBlocks && <BlockRenderer blocks={page.blocks!} />}
  {!hasBlocks && (
    <Section spacing="default">
      <Container width="prose">
        <article>
          <h1>{page.title}</h1>
          {bodyHtml && <Prose class="mt-6" set:html={bodyHtml} />}
        </article>
      </Container>
    </Section>
  )}
  {hasBlocks && bodyHtml && (
    <Section spacing="default">
      <Container width="prose">
        <article>
          <Prose set:html={bodyHtml} />
        </article>
      </Container>
    </Section>
  )}
</Layout>
