# URL del CMS Strapi — usato lato server per le chiamate API
# Definito come server-secret in astro:env (letto a runtime, non inlinato nel bundle)
STRAPI_URL=http://localhost:1337

# URL del CMS Strapi — esposto al client (es. per i form che postano direttamente a Strapi)
# Definito come client-public in astro:env. Opzionale: se non impostato, usa localhost:1337
PUBLIC_STRAPI_URL=http://localhost:1337

# Token API Strapi — necessario per le mutation autenticate (form, POST, ecc.)
# Genera da: Strapi admin → Settings → API Tokens → Create new token
# Opzionale: in sviluppo lascia vuoto se non usi endpoint autenticati
STRAPI_API_TOKEN=
